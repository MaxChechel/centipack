---
import Media from './Media.astro';
import Button from '../atoms/Button.astro';
import type { CategoryView } from '../../lib/catalogue';

/**
 * CategoryCard — the second card-pattern instantiation (§4.2).
 *
 * A photograph with the category's name at the top, its paragraph at the bottom
 * and a link under that. It shares no structure with ProductCard — different
 * elements, different internal layout, different interaction — so the two are
 * SIBLINGS rather than subclasses, and a common parent would be a bordered
 * <div>, which is a class and not a component.
 *
 * `data-theme="dark"` IS THE MECHANISM, not a colour choice. Everything here
 * sits over a photograph with two gradient scrims drawn across it, so the region
 * genuinely is a dark one: marking it says so once, and the heading, the
 * paragraph and the Button all recolour themselves with no literal anywhere in
 * this file. The same card on a light ground would need no edit.
 *
 * THE IMAGE IS IN FLOW AND THE CONTENT OVERLAYS IT, rather than the other way
 * round. That is what lets the card's height come from the picture's own aspect
 * ratio — 5:6, which is the 440 × 532 the design draws — instead of from a
 * hand-set height that would be wrong at the next width.
 *
 * THE WHOLE CARD IS CLICKABLE, and it is still one target. The Button under the
 * paragraph remains the only anchor; `.category-card-link` stretches its
 * ::after across the card so the press lands anywhere. The card is NOT wrapped
 * in an <a> — that would fold the heading, the paragraph and the label into one
 * announced name. One target, one accessible name, no duplicate announcement.
 */
interface Props {
  category: CategoryView;
  headingLevel?: 2 | 3;
  /**
   * ONE READING, NOT TWO. This carried `cross`, `ratio` and `body` — a second
   * mode for the pair of cross-links at the foot of a category page, drawn 1:1
   * with the short copy and sometimes a per-host override. v1 draws that pair
   * as a different object entirely: a 128px thumb with black type beside it and
   * a round arrow button, which is `CrossLinks.astro`. The three props went
   * with the use that needed them.
   */
  /**
   * How wide this card is DRAWN, forwarded to `Media` as `sizes`.
   *
   * The card cannot work it out: it is 440px three-up on the home page and
   * **656px two-up** at the foot of a category page, and only the page laying it
   * out knows which. Without this a browser picks its srcset candidate assuming
   * the image fills the viewport, which is wrong in both directions at once.
   */
  sizes?: string;
  class?: string;
}

const { category, headingLevel = 3, sizes, class: className } = Astro.props as Props;

/* `pageTitle`, NOT `title`. This read `cross ? pageTitle : title` and put
   "Cold Chain & Shipping" on the home page's cards — a menu label on a card
   with a paragraph under it, while the cross-link beside it said "Cold chain
   packaging". The v1 design draws `pageTitle` in both places (Figma 1005:13694
   and 1275:3369); one category, one display name. */
const title = category.pageTitle;
const body = category.cardBody;

/**
 * THE DARK TREATMENT IS A CONSEQUENCE OF THE PHOTOGRAPH, so it is conditional on
 * there being one. With the image pending there is nothing dark to sit on and
 * `theme="dark"` would paint ink-on-ink: the card renders as a light well
 * instead, which is legible, obviously unfinished, and reviewable — which is the
 * whole point of the pending state. One flag, two honest renderings, no second
 * component.
 */
const hasImage = Boolean(category.cardImage);
---

<article
  data-theme={hasImage ? 'dark' : undefined}
  class:list={[
    'category-card rounded-md relative isolate overflow-hidden',
    hasImage ? undefined : 'bg-subtle',
    className,
  ]}
>
  <Media image={category.cardImage} label={`${category.title} — card`} ratio="5 / 6" sizes={sizes} />

  {/* TWO SCRIMS, TOP AND BOTTOM, and only where there is a photograph to cover.
      The v1 design draws both; see `.category-card-scrim` in global.css for the
      measurements and for why the single ramp this card used to carry was never
      enough — the heading sits at the TOP, and the ramp only covered the
      bottom. */}
  {hasImage && (
    <>
      <div class="category-card-scrim category-card-scrim-top" aria-hidden="true" />
      <div class="category-card-scrim category-card-scrim-bottom" aria-hidden="true" />
    </>
  )}

  <div class="p-lg gap-lg absolute inset-0 z-10 flex flex-col justify-between">
    {
      /* One step up from h4 at the client's request. The LEVEL is still the
         prop's — this is the visual size only, which is the whole reason the
         type scale is named for size rather than for level (§5). */
      headingLevel === 2 ? (
        <h2 class="text-h3 text-primary">{title}</h2>
      ) : (
        <h3 class="text-h3 text-primary">{title}</h3>
      )
    }

    <div class="gap-md flex flex-col items-start">
      <p class="text-body text-primary">{body}</p>
      {/* `category-card-link` stretches this link over the whole card — see
          global.css. Still one target and one accessible name. */}
      <Button
        href={category.href}
        variant="ghost"
        size="link"
        icon="arrow"
        class="category-card-link"
      >
        {category.cardLinkLabel}
      </Button>
    </div>
  </div>
</article>
