# build output
dist/
.astro/

# dependencies
node_modules/

# the font-authoring venv. scripts/subset-fonts.py needs fonttools + brotli, and
# they stay out of package.json because they are a build-time authoring tool
# rather than a dependency of the site (§7). The venv is local; the SUBSET OUTPUT
# under src/assets/fonts/ is committed, so a fresh clone builds without Python.
.venv/

# local env
.env
.env.production
.dev.vars

# verification artifacts (the harness is committed; its output is not)
.verify/

# wrangler's local Miniflare state — caches, D1/KV/R2 stubs, trace stores.
# Written by `npm run lighthouse`, which serves the build through `wrangler pages
# dev`. Local runtime scratch, not source; it was committed once before anyone
# looked at `git ls-files`.
.wrangler/

# macOS
.DS_Store

# editor
.vscode/
.idea/
