---
import Media from './Media.astro';
import Button from '../atoms/Button.astro';
import type { SlotImage } from '../../lib/catalogue';

/**
 * Copy one side, picture the other (§4.2) — "Tailored pack-outs" and "Brand
 * your box", which the v1 product pages alternate down the page.
 *
 * ONE COMPONENT WITH A SIDE PROP, not two components and not two pages'
 * markup. The two instances differ in exactly one thing — which side the
 * photograph is on — and everything else about them, the heading, the
 * standfirst, the paragraph, the qualifying note and the button, is identical
 * in structure. That is a prop, not a fork.
 *
 * `imageSide` IS A LAYOUT DECISION THIS BLOCK OWNS (§4.4) rather than one the
 * page makes, because it is intrinsic to the alternation: the second of these
 * on a page mirrors the first. The page says which, the block does it.
 *
 * ORDER IN THE SOURCE IS READING ORDER. The text comes first in the markup
 * whichever side it is drawn on, and `md:order-*` moves the picture — so a
 * screen reader and a narrow viewport both get heading-then-copy-then-picture,
 * and only the wide layout mirrors.
 */
interface Props {
  heading: string;
  /** The line under the heading — a standfirst, not a second heading. */
  subheading?: string;
  body: string;
  /** The qualifying sentence under the copy: smaller, quieter, and not a claim. */
  note?: string;
  action?: { label: string; href: string };
  image: SlotImage;
  imageSide?: 'start' | 'end';
  headingLevel?: 'h2' | 'h3';
  /**
   * Visual size, decoupled from `headingLevel` exactly as SectionHeader's is.
   *
   * THE PRODUCT PAGES AND THE CATEGORY PAGE DRAW THIS BLOCK AT TWO SIZES. A
   * product's split row is the page's own h2 — 48px at 1440 with a 24px
   * standfirst. The custom boxes category stacks three of them UNDER a 48px
   * section heading (Figma 1268:4222), so there they are 32 and 20: a step
   * down, because they are items in a list and not the heading of the band.
   * Defaulting to `h2` leaves all five product pages exactly as they were.
   */
  size?: 'h2' | 'h3';
  id?: string;
}

const {
  heading,
  subheading,
  body,
  note,
  action,
  image,
  imageSide = 'end',
  headingLevel = 'h2',
  size = 'h2',
  id,
} = Astro.props as Props;

/* Complete class strings — the scanner cannot see `text-${size}`. The two
   ramps move together: a 48px heading takes a 24px standfirst under it and a
   32px heading takes 20, which is the type scale's own pairing rather than two
   independent choices. */
const HEADING = { h2: 'text-h2 text-primary', h3: 'text-h3 text-primary' } as const;
const SUBHEADING = { h2: 'text-h4 text-primary', h3: 'text-h5 text-primary' } as const;

/* The design sets all three lines 20px apart at the smaller size (1268:4222)
   where the larger one runs 24 then 12. There is no 20px step on the spacing
   scale, so this snaps to 24 and 16 — the same ruling the cross-link card's
   gap got, and for the same reason. */
const INNER_GAP = { h2: 'gap-sm', h3: 'gap-md' } as const;
---

<div id={id} class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-center flex flex-col">
  <div
    class:list={[
      'gap-xl flex flex-col items-start md:col-span-5',
      imageSide === 'start' ? 'md:order-2 md:col-start-8' : 'md:order-1',
    ]}
  >
    <div class="gap-lg flex flex-col">
      {
        headingLevel === 'h3' ? (
          <h3 class={HEADING[size]}>{heading}</h3>
        ) : (
          <h2 class={HEADING[size]}>{heading}</h2>
        )
      }
      <div class:list={[INNER_GAP[size], 'flex flex-col']}>
        {subheading && <p class={SUBHEADING[size]}>{subheading}</p>}
        <p class="text-body text-secondary">{body}</p>
      </div>
    </div>

    {/* The note is `--text-caption` and `--text-tertiary` because it is a
        qualification, not a claim — "actual thermal performance depends on the
        complete pack-out". Giving it body weight would make it read as another
        selling sentence, which is the opposite of its job. */}
    {note && <p class="text-caption text-tertiary">{note}</p>}

    {action && (
      <Button href={action.href} variant="primary">
        {action.label}
      </Button>
    )}
  </div>

  <Media
    image={image.picture}
    label={image.label}
    ratio="660 / 480"
    sizes="(min-width: 90rem) 660px, (min-width: 48rem) 50vw, 100vw"
    class:list={[
      'rounded-card md:col-span-6',
      imageSide === 'start' ? 'md:order-1 md:col-start-1' : 'md:order-2 md:col-start-7',
    ]}
  />
</div>
