---
import { Font } from 'astro:assets';
import { canonicalUrl, canonicalPath } from '../../lib/urls';
import { SITE, isNoindexed } from '../../consts';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import JsonLd from '../atoms/JsonLd.astro';
import '../../styles/global.css';

/**
 * The page shell (§4.3).
 *
 * Owns <head>, the skip-link target, and the canonical/og normalization that
 * `build.format: 'file'` makes necessary (src/lib/urls.ts).
 */
interface Props {
  title: string;
  description?: string;
  /** Root-relative path to the share image. */
  ogImage?: string;
  /**
   * Force noindex. Routes listed in SITE.noindex are noindexed without this —
   * stated once in consts.ts and consumed here and by the sitemap, so the two
   * cannot drift.
   */
  noindex?: boolean;
  /** Renders without the site chrome. */
  bare?: boolean;
  /**
   * What KIND of page this is, for the `WebPage` node in the structured data.
   *
   * schema.org's page subtypes are a closed list and this union is the subset
   * this site has pages for — a string prop would let a typo ship a type no
   * consumer recognises, which fails silently because structured data has no
   * runtime.
   */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.ogImage,
  noindex = false,
  bare = false,
  pageType = 'WebPage',
} = Astro.props as Props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const path = canonicalPath(Astro.url.pathname);
const isNoindex = noindex || isNoindexed(path);
const ogImageAbsolute = ogImage ? new URL(ogImage, Astro.site).href : undefined;

/**
 * SITE-WIDE STRUCTURED DATA (§8).
 *
 * Until now the only JSON-LD on this site was the `BreadcrumbList` that
 * `Breadcrumb` emits with its own trail — so four pages carried one type, and
 * Home, About and Contact carried nothing. **Nothing anywhere said that
 * CentiPack is an organisation**, which is the node a search engine attaches a
 * brand to.
 *
 * ONE `@graph`, NOT THREE SEPARATE BLOCKS. The three nodes reference each other
 * by `@id` — the page is `isPartOf` the site, the site is `publisher`ed by the
 * organisation — and a graph is how you say that once. Three unlinked blocks
 * describe three unrelated things that happen to share a page.
 *
 * `BreadcrumbList` stays where it is, emitted by the component that draws the
 * visible trail. That coupling is the point (see Breadcrumb.astro): a page
 * cannot get the structured trail without the one a person can see, and moving
 * it here would break exactly that.
 *
 * EVERY VALUE IS SOMETHING THE SITE ALREADY SAYS. No address, no telephone, no
 * `sameAs`, no `foundingDate` — none of them are published anywhere on this
 * site, and structured data is the wrong place to debut a fact nobody can check
 * against the page. The phone was deliberately removed site-wide (Footer), and
 * the social accounts do not exist.
 *
 * NO `parentOrganization` EITHER, which is the one that was tempting: About says
 * "We come from Centigrade Logistics, a cold chain operation". That is a
 * sentence about where the founders came from. It is not a claim about
 * corporate structure, and asserting one from it would be inventing a fact in
 * the one format that reads as authoritative precisely because a machine wrote
 * it.
 */
const ORG_ID = `${SITE.origin}/#organization`;
const SITE_ID = `${SITE.origin}/#website`;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: SITE.name,
      url: SITE.origin,
      description: SITE.description,
      email: SITE.email,
      logo: {
        '@type': 'ImageObject',
        url: new URL('/apple-touch-icon.png', SITE.origin).href,
        width: 180,
        height: 180,
      },
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        email: SITE.email,
        url: new URL(SITE.contactHref, SITE.origin).href,
      },
    },
    {
      '@type': 'WebSite',
      '@id': SITE_ID,
      url: SITE.origin,
      name: SITE.name,
      description: SITE.description,
      publisher: { '@id': ORG_ID },
      inLanguage: SITE.locale,
      /* NO `SearchAction`. It is the one thing everybody copies into a WebSite
         node, and it declares a search endpoint — this site has no search, so
         it would point at a URL that 404s. */
    },
    {
      '@type': pageType,
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      isPartOf: { '@id': SITE_ID },
      inLanguage: SITE.locale,
      ...(ogImageAbsolute && { primaryImageOfPage: ogImageAbsolute }),
    },
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImageAbsolute && (
        <>
          <meta property="og:image" content={ogImageAbsolute} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/* DM Sans, declared in astro.config.mjs. `preload` emits the <link rel="preload">
        for the one face the site ships; Astro emits the @font-face and the
        metric-matched fallback alongside it. */}
    <Font cssVariable="--font-body" preload />

    {/* ICONS. Three declarations and no more, which is the whole modern set:
        the .ico for browsers that do not read an SVG favicon, the SVG for those
        that do — it carries its own prefers-color-scheme rule, so one file
        answers a light and a dark tab strip — and the touch icon for iOS.

        `sizes="32x32"` on the .ico is not decoration: without it a browser may
        treat the ICO as the better candidate and never look at the SVG.

        Served from public/ at fixed paths because nothing here is optional
        reading — a browser requests /favicon.ico on its own and iOS requests
        /apple-touch-icon.png on its own, neither having read this markup. All
        four files are generated by scripts/build-icons.mjs from
        src/assets/brand/. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* The Organization / WebSite / WebPage graph. A page's own BreadcrumbList
        is emitted separately by Breadcrumb, beside the trail it describes. */}
    <JsonLd schema={structuredData} />
  </head>

  <body>
    {!bare && <Nav />}

    {/* id="main" is the skip link's real target. A skip link that points at an
         id no page has is the most common a11y bug there is. */}
    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}
  </body>
</html>
