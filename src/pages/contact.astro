---
/**
 * Contact (§4.4, §8).
 *
 * THE FORM SHIPS VISIBLY DISABLED. Every control carries `disabled` in the
 * markup, and only src/scripts/contact.ts re-enables it in the browser once
 * `data-contact-ready` is present. That is not belt-and-braces, it is the rule:
 * an unconfigured or undeployed endpoint silently swallowing a real enquiry is
 * the single most expensive failure a marketing site has, and it is the DEFAULT
 * state of every form nobody has verified end to end. Disabled-by-default
 * inverts it, and `scripts/verify/contracts.mjs` fails the build if a page with
 * no configured endpoint ships an enabled submit control.
 *
 * Turnstile is loaded on this page and nowhere else, and only once a site key
 * exists in the environment. No key → no widget, no third-party request, no
 * `data-contact-ready`, so the module leaves the controls disabled — and the
 * notice says so out loud rather than leaving a dead button.
 *
 * NO CTA BAND: this page is the call to action. Copy is verbatim from Figma
 * 788:9565; the five controls are exactly the ones the design draws, mapped onto
 * FormField in the Phase 1 audit.
 */
import BaseLayout from '../components/shells/BaseLayout.astro';
import Section from '../components/Section.astro';
import FormField from '../components/atoms/FormField.astro';
import Button from '../components/atoms/Button.astro';
import TextLink from '../components/atoms/TextLink.astro';
import { SITE } from '../consts';

/** PROJECT: set PUBLIC_TURNSTILE_SITE_KEY in the environment. Public by design —
 *  the secret half lives in the Pages Function's env and never in this repo. */
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const configured = Boolean(turnstileSiteKey);

/**
 * The select's ranges are NOT in the design — only the placeholder is drawn.
 * Open question 14. These are a stand-in shaped like the placeholder promises
 * ("up to 10,000+") and flagged rather than presented as final.
 */
const SHIPMENT_RANGES = [
  'Under 500 / week',
  '500 – 2,000 / week',
  '2,000 – 5,000 / week',
  '5,000 – 10,000 / week',
  '10,000+ / week',
];
---

<BaseLayout
  title={`Contact — ${SITE.name}`}
  description="We come back with a recommended build and pricing. There is no automated sequence behind this form — it goes straight to the team."
>
  <Section spaceTop="nav" spaceBottom="lg">
    <div class="gap-2xl md:gap-xl md:grid md:grid-cols-12 flex flex-col">
      {/* Left: the promise. */}
      <div class="gap-xl md:col-span-5 flex flex-col">
        <div class="gap-md flex flex-col">
          <h1 class="text-h2 text-primary">Contact us now</h1>
          <p class="text-body text-secondary measure">
            We come back with a recommended build and pricing. There is no automated sequence behind
            this form — it goes straight to the team, and the reply comes from whoever can answer it.
            Typically within one business day.
          </p>
        </div>

        <hr class="border-line w-full border-t" />

        <p class="gap-xl text-body flex">
          <span class="text-secondary">Email:</span>
          <TextLink href="mailto:info@centipack.com">info@centipack.com</TextLink>
        </p>
      </div>

      {/* Right: the form, on its own ground. */}
      <div class="bg-subtle rounded-md p-lg md:p-2xl md:col-span-6 md:col-start-7">
        {
          !configured && (
            <div class="border-line-strong bg-surface p-md gap-xs mb-lg flex flex-col rounded-sm border">
              <p class="text-h6 text-primary">This form is not live yet.</p>
              <p class="text-sm text-secondary">
                <code>PUBLIC_TURNSTILE_SITE_KEY</code> is unset, so no Turnstile widget is loaded and
                the controls below stay disabled. Configure the endpoint, verify a submission end to
                end, and it enables itself.
              </p>
            </div>
          )
        }

        <form
          method="POST"
          action="/api/contact"
          data-contact-form
          data-contact-ready={configured ? '' : undefined}
          data-form-disabled={configured ? undefined : ''}
          class="gap-lg flex flex-col"
        >
          <!-- Honeypot. Off-screen rather than display:none — some bots skip
               hidden fields, and none of them are looking at the viewport.
               aria-hidden + tabindex="-1" keep it away from real users entirely. -->
          <div class="sr-only" aria-hidden="true">
            <label for="company_website">Leave this field empty</label>
            <input id="company_website" type="text" name="company_website" tabindex="-1" autocomplete="off" />
          </div>

          <!-- Stamped in the browser by src/scripts/contact.ts. A build-time
               value would be baked into the HTML and cached. -->
          <input type="hidden" name="started_at" value="0" />

          <FormField
            label="Full Name"
            name="name"
            required
            disabled={true}
            autocomplete="name"
            placeholder="Your name"
          />
          <FormField
            label="Work email"
            name="email"
            type="email"
            required
            disabled={true}
            autocomplete="email"
            inputmode="email"
            placeholder="you@pharmacy.com"
          />
          <FormField
            label="Company"
            name="company"
            disabled={true}
            autocomplete="organization"
            placeholder="Pharmacy or brand name"
          />
          <FormField
            label="Projected shipments per week"
            name="volume"
            type="select"
            placeholder="Select a range — up to 10,000+"
            options={SHIPMENT_RANGES}
            disabled={true}
          />
          <FormField
            label="What are you shipping, and where?"
            name="message"
            type="textarea"
            rows={5}
            disabled={true}
            placeholder="e.g. GLP-1 injectables, nationwide next-day air, 3,000 packages/week"
          />

          {configured && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible" />}

          <Button type="submit" variant="primary" icon="square" iconPosition="start" disabled class="w-full">
            Send request
          </Button>

          {/*
            THE ANSWER HAS TO LAND SOMEWHERE ON THIS PAGE.

            The endpoint replies with JSON, and a native form POST to a JSON
            response NAVIGATES — the visitor would have left the site and be
            looking at `{"ok":true}` in a blank tab. That was the shipped
            behaviour, and `contact.ts` described it as "a redirect-friendly
            status", which the endpoint has never returned.

            `role="status"` + `aria-live="polite"` so the reply is announced
            rather than only drawn. It is empty and `hidden` at rest, so it
            occupies nothing until there is something to say.
          */}
          <p
            data-contact-status
            role="status"
            aria-live="polite"
            class="text-sm text-secondary"
            hidden
          />
        </form>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  import '../scripts/contact';
</script>

{
  /* Turnstile, on this page only and only when configured. `defer` rather than
     `async`: the widget must not race the form's own module. */
  configured && (
    <script is:inline defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
  )
}
