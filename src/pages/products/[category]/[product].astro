---
import BaseLayout from '../../../components/shells/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/atoms/Button.astro';
import Breadcrumb from '../../../components/blocks/Breadcrumb.astro';
import CtaPlate from '../../../components/blocks/CtaPlate.astro';
import Media from '../../../components/blocks/Media.astro';
import Faq from '../../../components/blocks/Faq.astro';
import FeatureGrid from '../../../components/blocks/FeatureGrid.astro';
import FormatCards from '../../../components/blocks/FormatCards.astro';
import MediaCards from '../../../components/blocks/MediaCards.astro';
import NumberedList from '../../../components/blocks/NumberedList.astro';
import SpecSheet from '../../../components/blocks/SpecSheet.astro';
import SplitFeature from '../../../components/blocks/SplitFeature.astro';
import StepList from '../../../components/blocks/StepList.astro';
import {
  getCatalogue,
  type CategoryView,
  type ProductSection,
  type ProductView,
} from '../../../lib/catalogue';
import { closingBand } from '../../../lib/closing-band';
import { SITE } from '../../../consts';

/**
 * Product family — one template, and as many pages as there are products with
 * content (§4.4, §5).
 *
 * THE PAGE IS ITS SECTIONS, AND THE SECTIONS ARE DATA. The five v1 products
 * share a vocabulary and not a skeleton: PuncturePack runs hero → how it works
 * → why choose → sizes → pack-outs → branding → applications → FAQ; gel packs
 * runs hero → network → construction → formats → custom options and ends
 * without an FAQ at all; thermal liners opens with a chooser nothing else has.
 * Eight section types, five different orders, so the order lives in the content
 * and this template is a switch over it. See the `section` union in
 * content.config.ts for the argument in full.
 *
 * WHICH PRODUCTS GET A PAGE IS THE SAME QUESTION. `getStaticPaths` emits a path
 * for a product that has sections and nothing for one that does not, which is
 * why `href` is optional on `ProductView` and why filtering on it here is the
 * same gate the nav, the footer and the cards read. Eight of the thirteen
 * products have no v1 design; they render as names, not links, and this route
 * emits no HTML for them. See `productPagesShip` in src/consts.ts.
 *
 * WHAT THIS TEMPLATE NO LONGER RENDERS: the six-cell `facts` list and the wide
 * `specTable`. Neither is drawn on any v1 product page — the two-column spec
 * sheet replaces the table, and the facts have no equivalent. Both are still in
 * the schema and still in the one content file that fills them, because that
 * copy came from the client's own redline and deleting it to tidy a template is
 * not this change's business. Flagged for review rather than quietly dropped.
 *
 * Copy is verbatim from Figma uMHWj1JRHoqmY9uOQNfyL6, nodes 1179:3192,
 * 1204:3919, 1205:3879, 1206:3839 and 1207:3793.
 */
export async function getStaticPaths() {
  const catalogue = await getCatalogue();
  return catalogue.flatMap(({ category, products }) =>
    products
      /* `href` IS the gate — see the note above. A product without sections has
         no href, so it gets no path, so the build emits no HTML for it. */
      .filter((product) => Boolean(product.href))
      .map((product) => ({
        params: { category: category.slug, product: product.slug },
        props: { product, category },
      })),
  );
}

interface Props {
  product: ProductView;
  category: CategoryView;
}

const { product, category } = Astro.props;
const cta = await closingBand();

/**
 * EXHAUSTIVENESS, ENFORCED AT COMPILE TIME.
 *
 * The template below renders each section with a `===` test, which TypeScript
 * narrows but does not COUNT: adding a ninth member to `ProductSection` and
 * forgetting it here would type-check cleanly and render a silent gap in the
 * page. This loop is what makes that a build error instead — the `never`
 * assignment in the default branch stops compiling the moment a member exists
 * that the cases above do not name.
 *
 * It asserts that every type is ACKNOWLEDGED, not that every type is drawn;
 * those are different claims and this is the one a type system can make. Its
 * failure mode was run before it shipped (§9): a `{ type: 'gallery' }` member
 * added to the union fails `astro check` with "Type 'Gallery' is not assignable
 * to type 'never'" and names the file and line.
 */
const assertEverySectionIsHandled = (sections: readonly ProductSection[]): void => {
  for (const section of sections) {
    switch (section.type) {
      case 'steps':
      case 'features':
      case 'specs':
      case 'split':
      case 'numbered':
      case 'cards':
      case 'formats':
      case 'faq':
        break;
      default: {
        const unhandled: never = section;
        throw new Error(`Unhandled product section: ${JSON.stringify(unhandled)}`);
      }
    }
  }
};
assertEverySectionIsHandled(product.sections);

/**
 * WHICH GROUND A SECTION SITS ON, and it ALTERNATES.
 *
 * The v1 product pages band themselves: the hero is `#f2eee8`, then every
 * content section after it flips between white and `#f2eee8` down the page,
 * and the FAQ and closing band settle onto `#f9f7f5`. Sampled off two pages
 * with different section mixes to establish that it is alternation rather than
 * a colour per section type — the same `split` block is white on one row and
 * `#f2eee8` two rows later:
 *
 *   mailers (1204:3919)   hero f2eee8 · steps #fff · features f2eee8 ·
 *                         specs #fff · split f2eee8 · split #fff ·
 *                         numbered f2eee8 · faq f9f7f5 · cta f9f7f5
 *   gel packs (1207:3793) hero f2eee8 · numbered #fff · features f2eee8 ·
 *                         formats #fff · numbered f2eee8 · cta f9f7f5
 *
 * So it is the INDEX that decides, not the type — which is why this is a
 * function of the position rather than a field on the section. A ground stored
 * in the content would have to be re-typed every time a section is inserted,
 * and would be wrong the moment someone forgot.
 *
 * The FAQ is the one exception, and it is the design's: it leaves the
 * alternation and lands on the same `#f9f7f5` as the closing band under it, so
 * the page ends on one ground rather than on a stripe.
 */
const sectionGround = (section: ProductSection, index: number): string =>
  section.type === 'faq' ? 'bg-base' : index % 2 === 0 ? 'bg-surface' : 'bg-subtle';
---

<BaseLayout
  title={`${product.pageTitle} — ${category.title} | ${SITE.name}`}
  description={product.lede ?? `${product.title} — ${product.summary}. ${category.summary}`}
>
  <Section spaceTop="nav" spaceBottom="lg" class="bg-subtle">
    <div class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-end flex flex-col">
      <div class="gap-lg md:col-span-7 flex flex-col">
        {/* Home is the first crumb on every trail on this site. The v1
            product pages start theirs at "Products", and the category pages
            one level up start theirs at "Home" — two trails to the same
            branch disagreeing. Kept at Home, so the BreadcrumbList in the
            structured-data graph has one root. */}
        <Breadcrumb
          trail={[
            { label: 'Home', href: '/' },
            { label: 'Products', href: '/products' },
            { label: category.title, href: category.href },
            { label: product.title },
          ]}
        />
        <h1 class="text-h1 text-primary">{product.pageTitle}</h1>
        {product.descriptor && <p class="text-eyebrow">{product.descriptor}</p>}
      </div>

      <div class="gap-xl md:col-span-4 md:col-start-9 flex flex-col items-start">
        {product.lede && <p class="text-body text-secondary">{product.lede}</p>}
        {
          product.contactLinkLabel && (
            <Button href={SITE.contactHref} variant="ghost" size="link" icon="arrow">
              {product.contactLinkLabel}
            </Button>
          )
        }
      </div>
    </div>
  </Section>

  {/* The hero picture, full-bleed — the same treatment the category pages give
      their range shot, and the same deviation from the drawn 1344px plate. See
      the note on the home page's hero. */}
  <Section width="full" space="none" class="bg-subtle">
    <Media
      image={product.heroImage}
      label={`${product.title} — hero`}
      ratio="1344 / 541"
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="page-hero-media"
    />
  </Section>

  {
    product.sections.map((section, index) => (
      <Section space="lg" class={sectionGround(section, index)}>
        {section.type === 'steps' && (
          <StepList heading={section.heading} steps={section.steps} image={section.image} />
        )}

        {section.type === 'features' && (
          <FeatureGrid heading={section.heading} features={section.features} />
        )}

        {section.type === 'specs' && (
          <SpecSheet
            heading={section.heading}
            intro={section.intro}
            note={section.note}
            columns={section.columns}
            rows={section.rows}
            image={section.image}
          />
        )}

        {section.type === 'split' && (
          <SplitFeature
            heading={section.heading}
            subheading={section.subheading}
            body={section.body}
            note={section.note}
            action={section.action}
            image={section.image}
            imageSide={section.imageSide}
          />
        )}

        {section.type === 'numbered' && (
          <NumberedList heading={section.heading} body={section.body} items={section.items} />
        )}

        {section.type === 'cards' && (
          <MediaCards heading={section.heading} cards={section.cards} />
        )}

        {section.type === 'formats' && (
          <FormatCards heading={section.heading} cards={section.cards} />
        )}

        {/* SELF-SKIP (§4.2). The adapter drops any question whose answer is
            still owed, so this list can arrive empty — and `Faq` would render
            its top rule and nothing else. A heading over one hairline is worse
            than no section. Every answer exists today; this is the guard for
            the next FAQ that arrives as questions first. */}
        {section.type === 'faq' && section.items.length > 0 && (
          <div class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-start flex flex-col">
            <h2 class="text-h2 text-primary md:col-span-4">{section.heading}</h2>
            <Faq items={section.items} class="md:col-span-7 md:col-start-6" />
          </div>
        )}
      </Section>
    ))
  }

  <Section space="md" spaceTop="lg" class="bg-base">
    <CtaPlate {...cta} />
  </Section>
</BaseLayout>
