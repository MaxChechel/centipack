---
import BaseLayout from '../components/shells/BaseLayout.astro';
import Section from '../components/Section.astro';
import Media from '../components/blocks/Media.astro';
import Breadcrumb from '../components/blocks/Breadcrumb.astro';
import { getPage, getSite } from '../lib/site';

/**
 * About (§4.4).
 *
 * One Section. The design centres a heading, a picture and a single column of
 * prose — no bands, no cards, no closing banner — so the page is one `narrow`
 * container and nothing else, which is what the grammar looks like when a page
 * genuinely is one thing.
 *
 * The body is `.prose` rather than a stack of styled paragraphs: it is
 * long-form copy, and §2.5's scoped prose style is what owns paragraph rhythm.
 *
 * THE WORDS ARE CONTENT: src/content/pages/about.md (WORKLOG 183). Copy was
 * originally from Figma 788:9540.
 */

const page = await getPage('about');
const site = await getSite();

/* The photograph's width cap (1800, the 2x file for a 900px slot) is in
   src/lib/site.ts, PAGE_IMAGE_WIDTH. */
---

<BaseLayout
  pageType="AboutPage"
  title={page.title}
  description={page.description}
  ogImage={page.ogImage}
  noindex={page.noindex}
>
  <Section width="narrow" spaceTop="nav" space="lg" reveal="hero">
    <div class="gap-2xl flex flex-col items-center">
      {/* The trail every other page carries. It was missing here and on
          Contact, which left two of the seven launch pages out of the
          BreadcrumbList graph and, more visibly, out of the one navigation
          affordance the rest of the site is consistent about. Centred, because
          this page is centred — placement follows the page, the component does
          not impose one. */}
      <Breadcrumb trail={[{ label: site.labels.home, href: '/' }, { label: page.label }]} />
      <h1 class="text-h2 text-primary max-w-[27rem] text-center">{page.heading}</h1>

      <Media
        image={page.image}
        label="A warehouse aisle racked with EPS foam coolers"
        ratio="900 / 520"
        loading="eager"
        fetchpriority="high"
        sizes="(min-width: 64rem) 900px, 92vw"
        class="rounded-plate w-full"
      />

      {page.sections.map((section) => section.type === 'prose' && (
      <div class="gap-2xl flex flex-col">
        {/* ORIGINALLY FROM FIGMA 1005:14620. The frame reads "high-volume
            fulfilment"; the site spells it "fulfillment" everywhere, and the
            entry keeps the US spelling (open question 101). */}
        <div class="prose">
          {section.paragraphs.map((paragraph) => (
          <p>
            {paragraph}
          </p>
          ))}
        </div>

        {section.closer && (
        <p class="text-h5 text-primary measure">
          {section.closer}
        </p>
        )}
      </div>
      ))}
    </div>
  </Section>
</BaseLayout>
