---
import VisuallyHidden from './VisuallyHidden.astro';

/**
 * The canonical button atom (§4.1).
 *
 * Renders `<a>` when `href` is present and `<button>` otherwise, with the right
 * semantics either way. Every colour comes from the semantic token layer, so a
 * `theme="dark"` Section recolours every button inside it with no variant
 * classes and no `dark:` in markup.
 *
 * `primary` is the INVERSE fill, not the accent fill — CentiPack's primary
 * action is the ink colour (Brand/Black on light, pure white on dark), and the
 * accent is a navy the design spends elsewhere. The template ships `bg-accent`
 * here; this project's ruling is recorded in WORKLOG Entry 2 and the token pair
 * it needs (`--bg-inverse` / `--text-on-inverse`) is declared in global.css §2
 * with its own row in the contrast matrix.
 *
 * Hover LIFTS THE FILL ONE STEP rather than reversing it: `--bg-inverse-hover`
 * is a lighter ink on light and a softer white on dark, so the button keeps its
 * weight on the page as the pointer crosses it. Both states go through the
 * contrast matrix, because a label that goes illegible on hover fails for
 * exactly as long as anyone is looking at it.
 */
export type ButtonVariant = 'primary' | 'secondary' | 'ghost';
export type ButtonSize = 'sm' | 'md' | 'link';
/** Typed per §4.1; extend the union per project rather than passing markup. */
export type ButtonIcon = 'arrow' | 'play' | 'close' | 'square';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  icon?: ButtonIcon;
  iconPosition?: 'start' | 'end';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  /** Adds rel/target and the "opens in a new tab" hint. */
  external?: boolean;
  disabled?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  icon,
  iconPosition = 'end',
  href,
  type = 'button',
  external = false,
  disabled = false,
  class: className,
  ...rest
} = Astro.props as Props;

const Tag = href ? 'a' : 'button';

/**
 * THE SQUARE MARK IS A HOVER STATE, and it is no longer passed in.
 *
 * It used to be `icon="square"` on four call sites, drawn at rest. The ruling
 * is that it belongs to the hover of every filled and outlined button, so the
 * component decides rather than each caller — a mark that four pages remember
 * to ask for is a mark the fifth page forgets.
 *
 * THE LEFT PADDING OPENS UP WITH IT, and the right closes by the same step, so
 * the LABEL slides across while the button's own width never changes. That is
 * the point of swapping the two rather than just growing the left one: a
 * button that gets wider under the pointer shoves whatever sits beside it, and
 * in the home hero that is the second button moving every time you aim at the
 * first.
 *
 *   rest    24 left · 32 right   mark hidden
 *   hover   32 left · 24 right   mark shown, label 8px across
 *
 * The mark itself is absolutely positioned, so it adds no width at either
 * state and the swap above is the only thing moving. The visible square is
 * about 5px inside a 14px box; at `left: 0.875rem` it sits in the left padding
 * at rest and clears the slid label by roughly 11px on hover.
 *
 * THE PADDING IS A UTILITY PAIR, NOT A COMPONENT RULE, because utilities
 * outrank `@layer components` — a `px-lg` emitted by the lookup below would
 * beat any padding this file's stylesheet tried to set, which is the same trap
 * `.hero-stats` recorded. So the hover variant is generated by Tailwind and
 * the lookup is skipped for these buttons entirely.
 *
 * `size="link"` has no box to put it in, so it keeps its arrow and nothing else.
 */
const hasMark = (variant === 'primary' || variant === 'secondary') && size !== 'link';

/** The resting/hover padding pair, per size. Replaces PAD for marked buttons. */
const MARK_PAD = {
  sm: 'pl-md pr-lg hover:pl-lg hover:pr-md',
  md: 'pl-lg pr-xl hover:pl-xl hover:pr-lg',
  link: '',
} as const;

/**
 * Complete class strings. Never `` `bg-${variant}` `` — the scanner reads source
 * as text and would generate none of these.
 *
 * `secondary` takes `border-line-strong`, not `border-line`: its border is the
 * only thing saying "this is a control", which is WCAG 1.4.11's 3:1 case. A
 * divider-weight border here would be a real failure, not a style choice.
 */
const VARIANT = {
  /**
   * THE TAN FILL, AND IT USED TO BE THE INK ONE.
   *
   * The v1 button set draws the primary action on three grounds and the fill is
   * the tan `action/secondary/default` on both light ones and WHITE on the dark
   * one (Figma 1327:24580, 1327:24510, 1327:24598). `--bg-action` is themed to
   * do exactly that, so one variant covers all three and `primary` no longer
   * needs a sibling.
   *
   * `action` IS GONE. It existed because `primary` was the ink fill and the nav
   * needed the tan beside it; now they are the same button and keeping both
   * would be two names for one thing. The nav takes `primary` like everything
   * else.
   *
   * The ink fill is not lost — `--bg-inverse` still exists and still flips with
   * the ground. Nothing on the site asks for it today.
   */
  primary: [
    'bg-action text-on-action border-action',
    'hover:bg-action-hover hover:border-action-hover',
  ],
  /**
   * BRONZE OUTLINE, BRONZE LABEL — and it no longer reverses on hover.
   *
   * It was a neutral outline (`border-line-strong`) with an ink label that
   * filled with the ink on hover. The v1 set draws it in `#7a5f43` on both
   * light grounds and in white on the dark one, which `--outline-action` is
   * themed to do.
   *
   * THE HOVER FILLS IT WITH THE PRIMARY'S OWN FILL — border, background and
   * label all move at once: `--bg-action` behind, `--bg-action` on the border,
   * `--text-on-action` on the label. So the outlined button COMPLETES into the
   * filled one under the pointer, which is the same gesture it always had,
   * now pointing at the tan instead of the ink.
   *
   * At rest both halves clear their requirements on every light ground:
   * 5.13 : 1 at worst for the label against 4.5, and the same number against
   * 1.4.11's 3.0 for the border, which is the only thing saying "this is a
   * control". On hover it becomes the primary, which the action matrix
   * already covers at 7.94.
   */
  secondary: [
    'bg-transparent text-outline-action border-outline-action',
    'hover:bg-action hover:text-on-action hover:border-action',
  ],
  /**
   * `ghost` IS THE ARROW LINK, and it is bronze again.
   *
   * THIS REVERSES AN EXPLICIT INSTRUCTION, so the history is here rather than
   * in a commit nobody reads. It was `text-secondary`, then black on the
   * instruction "for button with arrow type text use our black(text color)".
   * The v1 button set draws every arrow link in `#7a5f43` on a light ground and
   * white on a dark one — the same `--outline-action` the outlined button uses
   * — and that set is what has now been asked for. Later instruction wins; the
   * earlier one was not wrong when it was given.
   *
   * The hover darkens one step through `.btn-link`, which used to lighten to
   * --text-secondary and would now be a hue change rather than a step.
   */
  ghost: ['bg-transparent text-outline-action border-transparent', ''],
} as const;

/**
 * `link` is a CentiPack addition, and it is a size rather than a variant because
 * that is what actually differs: the design's tertiary action — "Browse formats
 * →", about fifteen of them across six page types — is a link with a trailing
 * arrow and no box at all. Everything else about it is a Button: it renders an
 * <a>, it takes an icon, it carries the disabled contract.
 *
 * The alternative was a new ArrowLink atom, which would have re-implemented the
 * icon plumbing and the href→<a> switch to gain nothing. `border-transparent`
 * rather than `border-0` keeps the box model identical to the other two sizes,
 * so a `link` and an `md` on the same row still sit on one baseline.
 */
const SIZE = {
  sm: 'h-control-sm gap-xs text-sm',
  md: 'h-control-md gap-xs text-body',
  /* `btn-link` carries the hover: the arrow slides and the label lightens, and
     an arrow that travels is not something a utility can say. */
  link: 'btn-link gap-2xs text-sm font-medium rounded-none border-transparent',
} as const;

/**
 * Padding is its own lookup because A START ICON UNBALANCES THE BOX. The square
 * mark sits inside the left padding's optical space, so a symmetric box reads as
 * leaning left; the design compensates by giving the trailing side one step
 * more — 24 / 32 at `md`, which is exactly what Figma draws.
 *
 * Two maps rather than one composed string: the scanner reads source as text, so
 * every class it must generate has to appear literally somewhere.
 */
const PAD = {
  sm: 'px-md',
  md: 'px-lg',
  link: '',
} as const;

const PAD_LEADING_ICON = {
  sm: 'pl-md pr-lg',
  md: 'pl-lg pr-xl',
  link: '',
} as const;

/** Inline, currentColor, sized to the label's cap height. */
const ICON_PATHS = {
  arrow: 'M2 8h12M9.5 3.5 14 8l-4.5 4.5',
  play: 'M4.5 2.5v11l9-5.5-9-5.5Z',
  close: 'm3.5 3.5 9 9m0-9-9 9',
  /* The mark the design puts before every primary button's label: a small
     filled square, drawn at the same 16-unit grid as the rest. */
  square: 'M5 5h6v6H5z',
} as const;

/** Only `square` is a filled mark; the rest are strokes. */
const ICON_FILLED: Partial<Record<ButtonIcon, boolean>> = { square: true };
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled || undefined}
  aria-disabled={href && disabled ? 'true' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  target={external ? '_blank' : undefined}
  class:list={[
    /* `whitespace-nowrap` IS RIGHT FOR A BOX AND WRONG FOR A TEXT LINK.
       A filled or outlined button is a fixed target and a label that wrapped
       inside one would look broken. `size="link"` has no box: it is a sentence
       with an arrow after it, so it wraps rather than pushing the viewport.
       That much is unchanged — the boxed sizes keep nowrap, the link size wraps.

       THE ARROW IS CENTRED ON THE LABEL, and this reverses an earlier ruling, so
       here is what changed rather than just the new value.

       `items-start` was correct for one specific reason: the copy deck wrote
       long tertiary labels — "How to choose the right cold chain configuration
       →" measured 367px, overflowed a 320px viewport, and the sweep caught it at
       320 and 360. A label that wraps to two lines wants its arrow on the FIRST
       line, beside the words, not floating in the middle of the block.

       The cost was paid on every single-line link, which is all of them most of
       the time: `align-items: start` pins a 16px glyph to the top of a ~20px
       line box, so the arrow sat visibly high of the label's optical centre —
       the whole site's tertiary action very slightly out of true.

       THE CONSTRAINT RETIRED ITSELF. Those long labels are gone: every arrow
       link on the site now reads "Browse cold chain", "Browse custom boxes",
       "Browse pharmacy formats", "Browse formats", "Browse all formats" or
       "Talk to us about this mailer" — 28 characters at the longest, which is
       roughly 190px at `--text-sm` and does not wrap at 320. Nothing is trading
       against the centring any more, so it goes to centre where it belongs.

       IF A LONG LABEL COMES BACK, this is the line that has to be reconsidered,
       and the wrapped arrow will centre against the block. It is a real
       trade-off and not a defect in either position — which is why both are
       written down. */
    'inline-flex items-center justify-center rounded-sm border',
    /* `relative` ONLY WHERE THE MARK NEEDS IT, and the unconditional version
       was a real bug. The mark is absolutely positioned, so the button has to
       be its containing block — but putting `relative` on EVERY button also
       made it the containing block for `.category-card-link::after`, which
       exists to stretch that link over the whole category card. The card
       silently stopped being clickable anywhere: measured with
       `elementFromPoint` at nine points across it, every one landed on a div,
       an h3 or a p and none on a link.

       `size="link"` never carries a mark, so this costs it nothing and gives
       the stretched hit area its containing block back. */
    hasMark && 'relative btn-has-mark',
    size !== 'link' && 'whitespace-nowrap',
    /* Springs are the default character of the system (§12), including here.
       `padding` joins the colour properties because the marked button slides
       its label on hover — see the note on `hasMark`. It is a layout property
       and it is animated deliberately: the change is confined INSIDE the
       button, whose own width is constant, so nothing outside it reflows. */
    'transition-[color,background-color,border-color,padding] duration-spring-soft ease-spring-soft',
    // A disabled control must read as disabled.
    'disabled:pointer-events-none disabled:opacity-40 aria-disabled:pointer-events-none aria-disabled:opacity-40',
    SIZE[size],
    hasMark ? MARK_PAD[size] : icon && iconPosition === 'start' ? PAD_LEADING_ICON[size] : PAD[size],
    /* `link` owns its own hover, so the variant's does not also fire — two
       colour changes on one gesture read as a glitch rather than a response. */
    size === 'link' ? VARIANT[variant][0] : VARIANT[variant],
    className,
  ]}
  {...rest}
>
  {
    hasMark && (
      <span class="btn-mark" aria-hidden="true">
        <svg class="size-icon-inline" viewBox="0 0 16 16" fill="none">
          <path d={ICON_PATHS.square} fill="currentColor" />
        </svg>
      </span>
    )
  }
  {
    icon && iconPosition === 'start' && (
      <svg class="size-icon-inline" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d={ICON_PATHS[icon]}
          stroke={ICON_FILLED[icon] ? undefined : 'currentColor'}
          stroke-width={ICON_FILLED[icon] ? undefined : 1.25}
          fill={ICON_FILLED[icon] ? 'currentColor' : undefined}
        />
      </svg>
    )
  }
  <slot />
  {
    icon && iconPosition === 'end' && (
      <svg class="size-icon-inline" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d={ICON_PATHS[icon]}
          stroke={ICON_FILLED[icon] ? undefined : 'currentColor'}
          stroke-width={ICON_FILLED[icon] ? undefined : 1.25}
          fill={ICON_FILLED[icon] ? 'currentColor' : undefined}
        />
      </svg>
    )
  }
  {external && <VisuallyHidden> (opens in a new tab)</VisuallyHidden>}
</Tag>
