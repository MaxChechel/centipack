---
import BaseLayout from '../../components/shells/BaseLayout.astro';
import Section from '../../components/Section.astro';
import CrossLinks from '../../components/blocks/CrossLinks.astro';
import Breadcrumb from '../../components/blocks/Breadcrumb.astro';
import ProductRail from '../../components/blocks/ProductRail.astro';
import SplitFeature from '../../components/blocks/SplitFeature.astro';
import Carousel from '../../components/blocks/Carousel.astro';
import CtaPlate from '../../components/blocks/CtaPlate.astro';
import Media from '../../components/blocks/Media.astro';
import JsonLd from '../../components/atoms/JsonLd.astro';
import { getCatalogue, type CategoryView, type ProductView } from '../../lib/catalogue';
import { closingBand } from '../../lib/closing-band';

/**
 * Category — one template, three pages (§4.4, §5).
 *
 * `getStaticPaths` reads the catalogue, so adding a category to
 * `src/content/categories` adds a page, a nav column, a footer column and three
 * cross-links with no other edit. That is the whole reason the content layer is
 * CMS-shaped from the first commit.
 *
 * The closing band's picture and copy are shared with the products index through
 * `src/lib/closing-band.ts` — one source, three consumers, rather than the same
 * paragraph typed into three templates.
 *
 * Copy is verbatim from Figma 788:8952 / 788:9676 / 788:9850.
 */
export async function getStaticPaths() {
  const catalogue = await getCatalogue();
  return catalogue.map(({ category, products }) => ({
    params: { category: category.slug },
    props: { category, products, others: catalogue.filter((c) => c.category.slug !== category.slug).map((c) => c.category) },
  }));
}

interface Props {
  category: CategoryView;
  products: ProductView[];
  others: CategoryView[];
}

const { category, products, others } = Astro.props;
const cta = await closingBand();

/**
 * The products on this page, as an `ItemList`.
 *
 * DERIVED FROM THE SAME ARRAY THE RAIL RENDERS, which is the only reason it is
 * worth emitting: a hand-kept list beside a rendered one is two lists, and
 * §5's rule about second sources applies to structured data exactly as it does
 * to a nav.
 *
 * `url` FOLLOWS THE LAUNCH GATE. `product.href` is `undefined` while product
 * detail pages are out of scope (src/consts.ts), and a `ListItem` pointing at a
 * route the build does not emit is a 404 stated in a format that reads as
 * authoritative. So the entries carry names now and gain URLs on the same flag
 * that gives them pages — no second edit, and no window where the two disagree.
 */
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: category.selectionHeading,
  numberOfItems: products.length,
  itemListElement: products.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: product.title,
    ...(product.href && { url: new URL(product.href, Astro.site).href }),
  })),
};
---

<BaseLayout
  pageType="CollectionPage"
  title={`${category.pageTitle} — ${category.title} | CentiPack`}
  description={category.lede}
>
  {/* 1 — Hero. Same shape as the products index: trail, h1, lede in column two. */}
  {/* `spaceTop="lg"`, not the shared `nav` step: the design draws the category
      and index heroes 166px below the nav where the home and product heroes sit
      at 78. 120 is the nearest step up and still 46 short, which is closer than
      the 70 the nav step leaves. */}
  <Section spaceTop="lg" spaceBottom="sm" class="bg-subtle" reveal="hero">
    <div class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-end flex flex-col">
      <div class="gap-lg md:col-span-7 flex flex-col">
        <Breadcrumb
          trail={[
            { label: 'Home', href: '/' },
            { label: 'Products', href: '/products' },
            { label: category.title },
          ]}
        />
        <h1 class="text-h1 text-primary">{category.pageHeading}</h1>
      </div>
      <p class="text-body text-secondary md:col-span-4 md:col-start-9">{category.lede}</p>
    </div>
  </Section>

  {/* 2 — The range in one picture, a plate inside the page gutter.

      CONTAINED ON INSTRUCTION, AND THAT IS A DEVIATION. v1 draws this one
      full-bleed at 1440 x 700 (Figma 1005:14041) — it is the one hero the
      design never contained — and the ruling is that every hero on the site
      sits in the container. Recorded in AUDIT D8.

      `bg-subtle`, matching the copy band above. A contained picture shows the
      Section's ground in the gutters beside it, and on the old base ground
      that was a seam at the plate's top corners where subtle met base. Now the
      copy and the picture are one band, the same shape the product hero has.

      `spaceBottom="sm"` gives the plate ground under it, the same 48px as the
      gap above. Full-bleed had none because the next section started on the
      picture's edge; against a rounded plate that butts. */}
  <Section spaceTop="none" spaceBottom="sm" class="bg-subtle">
    <Media
      image={category.rangeImage}
      label={`${category.title} — the range together`}
      ratio="1440 / 700"
      loading="eager"
      fetchpriority="high"
      sizes="(min-width: 90rem) 1344px, 100vw"
      class="page-hero-media rounded-plate"
    />
  </Section>

  {/* 3 — The category's own body.

      TWO SHAPES, AND THE CONTENT PICKS. Cold chain and pharmacy formats sell a
      shelf of products, so their page is a heading and a rail of cards. Custom
      boxes sells a capability: its v1 page (Figma 1005:14931) draws three rows
      describing what can be built and then a carousel of the options, and no
      product rail at all.

      The test is `category.sections.length`, never the slug. A template that
      asks which page it is has the page's identity compiled into the one file
      whose job is to not know it — and the next category that wants rows would
      need a second branch beside the first. See the schema's note. */}
  {
    category.sections.length > 0 ? (
      <Section space="lg" reveal>
        <div class="gap-4xl flex flex-col">
          {/* THE SAME HEADING THE RAIL BRANCH USES. The design puts
              "Thoughtfully packaged. Ready to deliver." over the rows exactly
              where the other two categories put it over their cards, so this
              is `selectionHeading` doing its job rather than a second field
              holding the same sentence. */}
          <h2 class="text-h2 text-primary">{category.selectionHeading}</h2>
          {category.sections.map((section) =>
            section.type === 'split' ? (
              <SplitFeature
                heading={section.heading}
                subheading={section.subheading}
                body={section.body}
                note={section.note}
                action={section.action}
                image={section.image}
                imageSide={section.imageSide}
                headingLevel="h3"
                size="h3"
              />
            ) : null,
          )}
        </div>
      </Section>
    ) : (
      <Section space="lg" reveal>
        <div class="gap-2xl flex flex-col">
          <h2 class="text-h2 text-primary">{category.selectionHeading}</h2>
          <ProductRail products={products} columns={3} label={`${category.title} products`} />
          {/* Emitted beside the rail it describes, for the same reason Breadcrumb
              emits its own: the markup and the structured data come from one array.

              IT GOES WITH THE RAIL, not with the page. A category that renders
              rows instead of cards is not publishing a list of products, and an
              ItemList naming products the page never mentions is structured
              data describing a page that does not exist. */}
          <JsonLd schema={itemList} />
        </div>
      </Section>
    )
  }

  {/* 4 — The carousel, where there is one.
      ITS OWN FULL-BLEED SECTION, because the track genuinely needs the
      viewport: the neighbouring cards run off both edges, which is what says
      the row scrolls. §4.4 puts that decision at Section level rather than
      letting the block break its own container. */}
  {
    category.sections
      .filter((section) => section.type === 'carousel')
      .map((section) =>
        section.type === 'carousel' ? (
          <Section width="full" space="lg" class="bg-base" reveal>
            <Carousel heading={section.heading} lede={section.lede} slides={section.slides} />
          </Section>
        ) : null,
      )
  }

  {/* 4 — The other two layers.

      ONE STRING FOR BOTH CARDS, WHEREVER THEY APPEAR. This used to pass a
      per-host override: the copy deck wrote the pharmacy card shorter on the
      cold chain page than on the custom boxes page, so the content carried a
      `crossBodyOverrides` map keyed by the host page. v1 writes one line per
      category and uses it on both pages that link to it — verified across all
      six cards in Figma — so the override map is gone and `crossBody` is simply
      the category's own line. */}
  {/* `space="md"` — the design pads this band 80px; 96 is the nearest step. */}
  <Section space="md" class="bg-subtle" reveal>
    <CrossLinks
      eyebrow="The rest of the build"
      body="Pharmacy formats, custom boxes, and cold chain packaging — available individually or as a complete solution."
      categories={others}
    />
  </Section>

  {/* 5 — The closing band. */}
  {/* `space="md"` BOTH SIDES — one global step, 96px, on instruction. The
      design's `cta desktop` instance has no top padding and 64-96 below, which
      is what this carried; the ruling is that the closing band sits in the
      page's normal section rhythm like every other band. */}
  <Section space="md" reveal>
    <CtaPlate {...cta} />
  </Section>
</BaseLayout>

<script>
  /* Both modules no-op on a page without their hook — the rail's on the two
     categories that render cards, the carousel's on the one that renders rows.
     Astro bundles a template's scripts per page rather than per branch, so the
     alternative is a second template, which is a page's identity in a filename
     again. Both are in the census with budgets. */
  import '../../scripts/rail';
  import '../../scripts/carousel';
</script>
