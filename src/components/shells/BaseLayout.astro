---
import { Font } from 'astro:assets';
import { canonicalUrl, canonicalPath } from '../../lib/urls';
import { SITE, isNoindexed } from '../../consts';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';

/**
 * The page shell (§4.3).
 *
 * Owns <head>, the skip-link target, and the canonical/og normalization that
 * `build.format: 'file'` makes necessary (src/lib/urls.ts).
 */
interface Props {
  title: string;
  description?: string;
  /** Root-relative path to the share image. */
  ogImage?: string;
  /**
   * Force noindex. Routes listed in SITE.noindex are noindexed without this —
   * stated once in consts.ts and consumed here and by the sitemap, so the two
   * cannot drift.
   */
  noindex?: boolean;
  /** Renders without the site chrome. */
  bare?: boolean;
}

const { title, description = SITE.description, ogImage = SITE.ogImage, noindex = false, bare = false } =
  Astro.props as Props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site);
const path = canonicalPath(Astro.url.pathname);
const isNoindex = noindex || isNoindexed(path);
const ogImageAbsolute = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {isNoindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    {
      ogImageAbsolute && (
        <>
          <meta property="og:image" content={ogImageAbsolute} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }

    {/* DM Sans, declared in astro.config.mjs. `preload` emits the <link rel="preload">
        for the one face the site ships; Astro emits the @font-face and the
        metric-matched fallback alongside it. */}
    <Font cssVariable="--font-body" preload />

    {/* ICONS. Three declarations and no more, which is the whole modern set:
        the .ico for browsers that do not read an SVG favicon, the SVG for those
        that do — it carries its own prefers-color-scheme rule, so one file
        answers a light and a dark tab strip — and the touch icon for iOS.

        `sizes="32x32"` on the .ico is not decoration: without it a browser may
        treat the ICO as the better candidate and never look at the SVG.

        Served from public/ at fixed paths because nothing here is optional
        reading — a browser requests /favicon.ico on its own and iOS requests
        /apple-touch-icon.png on its own, neither having read this markup. All
        four files are generated by scripts/build-icons.mjs from
        src/assets/brand/. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>

  <body>
    {!bare && <Nav />}

    {/* id="main" is the skip link's real target. A skip link that points at an
         id no page has is the most common a11y bug there is. */}
    <main id="main">
      <slot />
    </main>

    {!bare && <Footer />}
  </body>
</html>
