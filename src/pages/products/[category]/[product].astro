---
import BaseLayout from '../../../components/shells/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import SectionStack from '../../../components/SectionStack.astro';
import Button from '../../../components/atoms/Button.astro';
import Breadcrumb from '../../../components/blocks/Breadcrumb.astro';
import CtaPlate from '../../../components/blocks/CtaPlate.astro';
import Media from '../../../components/blocks/Media.astro';
import {
  getCatalogue,
  type CategoryView,
  type ProductView,
} from '../../../lib/catalogue';
import { closingBand } from '../../../lib/closing-band';
import { SITE } from '../../../consts';
import { getSite } from '../../../lib/site';

/**
 * Product family — one template, and as many pages as there are products with
 * content (§4.4, §5).
 *
 * THE PAGE IS ITS SECTIONS, AND THE SECTIONS ARE DATA. The five v1 products
 * share a vocabulary and not a skeleton: PuncturePack runs hero → how it works
 * → why choose → sizes → pack-outs → branding → applications → FAQ; gel packs
 * runs hero → network → construction → formats → custom options and ends
 * without an FAQ at all; thermal liners opens with a chooser nothing else has.
 * Eight section types, five different orders, so the order lives in the content
 * and this template is a switch over it. See the `section` union in
 * content.config.ts for the argument in full.
 *
 * WHICH PRODUCTS GET A PAGE IS THE SAME QUESTION. `getStaticPaths` emits a path
 * for a product that has sections and nothing for one that does not, which is
 * why `href` is optional on `ProductView` and why filtering on it here is the
 * same gate the nav, the footer and the cards read. Eight of the thirteen
 * products have no v1 design; they render as names, not links, and this route
 * emits no HTML for them. See `productPagesShip` in src/consts.ts.
 *
 * WHAT THIS TEMPLATE NO LONGER RENDERS: the six-cell `facts` list and the wide
 * `specTable`. Neither is drawn on any v1 product page — the two-column spec
 * sheet replaces the table, and the facts have no equivalent. Both are still in
 * the schema and still in the one content file that fills them, because that
 * copy came from the client's own redline and deleting it to tidy a template is
 * not this change's business. Flagged for review rather than quietly dropped.
 *
 * Copy was originally from Figma uMHWj1JRHoqmY9uOQNfyL6, nodes 1179:3192,
 * 1204:3919, 1205:3879, 1206:3839 and 1207:3793.
 */
export async function getStaticPaths() {
  const catalogue = await getCatalogue();
  return catalogue.flatMap(({ category, products }) =>
    products
      /* `href` IS the gate — see the note above. A product without sections has
         no href, so it gets no path, so the build emits no HTML for it. */
      .filter((product) => Boolean(product.href))
      .map((product) => ({
        params: { category: category.slug, product: product.slug },
        props: { product, category },
      })),
  );
}

interface Props {
  product: ProductView;
  category: CategoryView;
}

const { product, category } = Astro.props;
const cta = await closingBand();
const site = await getSite();


/**
 * THE HERO'S OWN RATIO, for the same reason the spec drawing has one.
 *
 * `1344 / 541` was hardcoded here and it is right for three of the five pages:
 * EPS coolers, thermal liners and gel packs all draw a 1344x541 hero. The
 * PuncturePack frame draws 1344x756 — 16:9 — and the supplied photograph is
 * 16:9 to match. A fixed ratio would have cropped a quarter of its height off
 * a picture made to fit.
 *
 * Reading it from the picture makes the page follow the artwork. The fallback
 * is the three-page majority, and is only reached by the pending placeholder,
 * which has no intrinsic size.
 */
const heroRatio = product.heroImage
  ? `${product.heroImage.width} / ${product.heroImage.height}`
  : '1344 / 541';

---

<BaseLayout
  title={`${product.pageTitle} — ${category.title} | ${SITE.name}`}
  description={product.description}
  ogImage={product.ogImage}
  noindex={product.noindex}
>
  {/* `spaceBottom="sm"`, NOT `lg`, and the whole reason is the picture below.
      This hero is copy followed by a full-bleed plate, and the gap between the
      two is the section's bottom padding — so `lg` put 120px between the lede
      and the photograph it introduces, against the 48px the home and category
      heroes leave for exactly the same pairing. Measured, not guessed:

        home      pt-section-nav  pb-section-sm   48px
        category  pt-section-lg   pb-section-sm   48px
        product   pt-section-nav  pb-section-lg  120px   <- the odd one

      Fixed here rather than by redefining `.pb-section-lg`, which is what the
      instruction described: that utility is the `lg` step for every section on
      the site, and moving it would quietly close the gap under a dozen
      sections that have no picture under them and want the air. The rule is
      "a hero whose next element is its own image sits at `sm`", and the place
      to say that is the hero. Contact keeps `lg` — it has no picture. */}
  <Section spaceTop="nav" spaceBottom="sm" class="bg-subtle" reveal="hero">
    {/* TOP-ALIGNED, not bottom. The design puts both columns at y=0 of the hero
        row (Figma 1204:3924 and 1204:3928) — the trail and the H1 on the left,
        the lede and its link on the right, both starting at the same line.
        `items-end` was hanging them off a shared baseline instead, which with
        a taller right column pushed the H1 65px further down the page than the
        design draws it. The CATEGORY hero genuinely is bottom-aligned (its
        right column sits at y=53 of a 99px row) and keeps `items-end`. */}
    <div class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-start flex flex-col">
      <div class="gap-lg md:col-span-7 flex flex-col">
        {/* Home is the first crumb on every trail on this site. The v1
            product pages start theirs at "Products", and the category pages
            one level up start theirs at "Home" — two trails to the same
            branch disagreeing. Kept at Home, so the BreadcrumbList in the
            structured-data graph has one root. */}
        <Breadcrumb
          trail={[
            { label: site.labels.home, href: '/' },
            { label: site.labels.products, href: '/products' },
            { label: category.title, href: category.href },
            { label: product.title },
          ]}
        />
        <h1 class="text-h1 text-primary">{product.pageTitle}</h1>
        {product.descriptor && <p class="text-eyebrow">{product.descriptor}</p>}
      </div>

      <div class="gap-xl md:col-span-4 md:col-start-9 flex flex-col items-start">
        {product.lede && <p class="text-body text-secondary">{product.lede}</p>}
        {
          product.contactLinkLabel && (
            <Button href={SITE.contactHref} variant="ghost" size="link" icon="arrow">
              {product.contactLinkLabel}
            </Button>
          )
        }
      </div>
    </div>
  </Section>

  {/* The hero picture, a plate inside the page gutter — what v1 draws (1344
      wide at x=48, Figma 1179:3206 and siblings), and the end of AUDIT D8 for
      the five product pages. Same treatment as the home and category heroes;
      see the note on the home page's.

      `spaceBottom="md"`: ground under the plate, 48px on a phone and 96px at
      1440, so the first section's band does not butt against its corners. */}
  <Section spaceTop="none" spaceBottom="md" class="bg-subtle" reveal="hero">
    <Media
      image={product.heroImage}
      label={`${product.title} — hero`}
      ratio={heroRatio}
      sizes="(min-width: 90rem) 1344px, 100vw"
      loading="eager"
      fetchpriority="high"
      class="page-hero-media rounded-plate"
    />
  </Section>

  <SectionStack sections={product.sections} />

  {/* `space="md"` BOTH SIDES — one global step, 96px, on instruction. The
      design's `cta desktop` instance has no top padding and 64-96 below, which
      is what this carried; the ruling is that the closing band sits in the
      page's normal section rhythm like every other band. */}
  <Section space="md" class="bg-base" reveal>
    <CtaPlate {...cta} />
  </Section>
</BaseLayout>
