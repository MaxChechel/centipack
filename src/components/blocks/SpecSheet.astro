---
import Media from './Media.astro';
import type { ProductSpecRow, SlotImage } from '../../lib/catalogue';

/**
 * "Sizes and specifications" (§4.2) — the v1 two-column specification sheet,
 * beside the dimension drawing.
 *
 * A SIBLING OF SpecTable, NOT A REPLACEMENT FOR IT, the same way CtaPlate is a
 * sibling of CtaBanner. That one is eight columns of measurements that do not
 * fit a phone, so it owns a focusable scroll container and a caption; this is
 * two columns — the thing and its options — that fit 320px with room, and a
 * scroll affordance on it would be a control with nothing to scroll. Different
 * structure, different interaction, different accessibility problem. Bolting a
 * `layout` prop onto SpecTable would have produced one component whose every
 * branch forked on it, which is two components wearing one name.
 *
 * SpecTable IS CURRENTLY UNREFERENCED, and that is stated here rather than
 * left to be discovered. The only `specTable` in the repo held placeholder
 * values the v1 design supersedes with real ones, so the data went and the
 * component has nothing to render. It is kept rather than deleted because the
 * eight products with no v1 page may yet want a wide size table, and because
 * deleting a component is a reviewable decision rather than a side effect of
 * transcribing a design. Open question at the gate: keep it or cut it.
 *
 * STILL A REAL <table>. Each row is a specification and the options available
 * for it, and the association between the two is the content — a definition
 * list was the other candidate and loses the column headers, which the design
 * draws and which say what the second column IS. `scope="row"` on the
 * specification name makes every value in the row be about it.
 *
 * The image is a drawing rather than a photograph ("dimension drawing: envelope
 * measurement convention + usable payload space"), and it does not exist yet —
 * `Media` prints the brief in the pending box, which is the design's own
 * convention for a slot that is owed.
 */
interface Props {
  heading: string;
  /** The paragraph UNDER the heading. */
  intro?: string;
  /** The qualifying sentence under the table. */
  note?: string;
  columns: readonly [string, string];
  rows: readonly ProductSpecRow[];
  image: SlotImage;
  headingLevel?: 'h2' | 'h3';
  id?: string;
}

const { heading, intro, note, columns, rows, image, headingLevel = 'h2', id } =
  Astro.props as Props;

/**
 * THE DRAWING'S OWN RATIO, not a number typed into this component.
 *
 * This was hardcoded `546 / 577`, which is the PuncturePack slot — and the
 * design draws a DIFFERENT slot per page: 546x577 there, 546x635 on the
 * insulated metallic mailers. Both supplied drawings match their own slot
 * exactly, so a fixed ratio here cropped one of them, and it cropped it at the
 * bottom, where the measurement caption is.
 *
 * Taking the ratio from the picture makes the component follow the artwork
 * instead of the other way round, and any future page gets it for free. The
 * fallback is only reached by the pending placeholder, which has no intrinsic
 * size to read.
 */
const specRatio = image.picture
  ? `${image.picture.width} / ${image.picture.height}`
  : '546 / 577';

const hasContent = rows.length > 0;
---

{hasContent && (
<div id={id} class="gap-2xl flex flex-col">
  {/* STACKED, NOT SPLIT. The standfirst used to sit in columns 8-12 opposite
      the heading. On instruction it reads under it, which is also the shape
      the rest of this block already has — the table and its picture are the
      two-column part of this section, and a header split across the same grid
      was competing with them for the same reading line.

      THE HEADING KEEPS ITS COLUMN. Both now sit in `md:col-span-7` rather than
      running the full width: a 48px heading measured across 1344px is a line
      nobody wants to read, and the grid is what the rest of the site states
      that measure in. */}
  <div class="md:grid md:grid-cols-12">
    <div class="gap-md flex flex-col md:col-span-7">
      {
        headingLevel === 'h3' ? (
          <h3 class="text-h2 text-primary">{heading}</h3>
        ) : (
          <h2 class="text-h2 text-primary">{heading}</h2>
        )
      }
      {intro && <p class="text-body text-secondary">{intro}</p>}
    </div>
  </div>

  <div class="gap-xl md:gap-lg md:grid md:grid-cols-12 md:items-start flex flex-col">
    {/* THE PICTURE IS WRAPPED, AND THE WRAPPER IS THE GRID ITEM.
        `specRatio` above exists so this block follows the artwork rather than
        the other way round, and for as long as the <img> was the grid item it
        did not: `Media` ships `h-full` on every slot, `height` beats
        `aspect-ratio`, and a grid item's `height: 100%` resolves against its
        AREA — so the picture took the row height the spec table sets and
        `object-cover` ate the difference off its sides.

        It was invisible while every spec picture was portrait. The mailers'
        new size chart is landscape: 546 wide wants 409 of height, the table
        was 691, and the crop took the 9" and 15" mailers out of frame
        entirely and sliced the caption mid-word.

        Wrapping it fixes the cascade rather than fighting it. The <img>'s
        `height: 100%` now resolves against a div of auto height, which
        computes to `auto`, which lets `aspect-ratio` govern — no `!important`,
        no unlayered override, no second height utility racing the first in
        the same layer. Same shape CrossLinks already uses. */}
    <div class="md:col-span-5">
      <Media
        image={image.picture}
        label={image.label}
        ratio={specRatio}
        sizes="(min-width: 90rem) 546px, (min-width: 48rem) 45vw, 100vw"
        class="rounded-card"
      />
    </div>

    <div class="gap-md md:col-span-6 md:col-start-7 flex flex-col">
      <table class="spec-sheet">
        <thead>
          <tr>
            <th scope="col" class="text-eyebrow">{columns[0]}</th>
            <th scope="col" class="text-eyebrow">{columns[1]}</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr>
                <th scope="row" class="text-body text-primary">{row.label}</th>
                <td class="text-body text-secondary">{row.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      {note && <p class="text-caption text-tertiary">{note}</p>}
    </div>
  </div>
</div>
)}
