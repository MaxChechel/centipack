---
/**
 * Eyebrow + heading + lede (§4.2).
 *
 * `lede` is the EDITORIAL slot — the standfirst under a section heading.
 *
 * CENTIPACK RENDERS IT AT `--text-body`, not at `--text-large`. Every lede in
 * the design is 16px, so `text-large` was simply the wrong step here; this
 * closes Phase 0's open question 4. `--text-large` keeps its value and its
 * meaning for the first standfirst that wants it.
 *
 * The default slot under the lede is the section's own action — the
 * "Browse all formats →" the design puts under the supporting column. It
 * renders only when something is passed, so a header without one is unchanged.
 *
 * HEADING LEVEL IS A PROP, and it is independent of the visual size. The same
 * block renders an <h2> at the top of a page and an <h3> inside a subsection
 * with no change to how it looks — which is the entire reason the type scale is
 * named for size (`.text-h2`) rather than for level. One h1 per page, zero
 * skips, verified by the sweep.
 *
 * Two layouts: stacked by default, or `split` to put supporting copy in a
 * second column on wide viewports.
 */
interface Props {
  eyebrow?: string;
  heading: string;
  /**
   * Document outline. Visual size is set by `size`, not by this.
   *
   * NOT named `as`. On a leaf component an `as` prop makes Astro's type layer
   * treat the component as polymorphic and DISCARD its Props type entirely —
   * silently, so every prop on it stops being checked. §4.2 reserves `<Tag>` and
   * the `as` name for Section, with its typing re-verified; leaves take
   * `headingLevel`. Found by `astro check` reporting a component's props as
   * `IntrinsicAttributes` with no `& Props`.
   */
  headingLevel?: 'h1' | 'h2' | 'h3' | 'h4';
  /** Visual size, decoupled from `as`. */
  size?: 'h1' | 'h2' | 'h3';
  lede?: string;
  /** Puts the lede in a second column from md up. */
  split?: boolean;
  /** Cap the heading column at the reading measure. */
  measure?: boolean;
  id?: string;
  class?: string;
}

const {
  eyebrow,
  heading,
  headingLevel = 'h2',
  size = 'h2',
  lede,
  split = false,
  measure = false,
  id,
  class: className,
} = Astro.props as Props;

/* Complete class strings — the scanner cannot see `text-${size}`. */
const SIZE = { h1: 'text-h1', h2: 'text-h2', h3: 'text-h3' } as const;
const headingClass = SIZE[size];

/* A lede supplied as a slot wins over the prop, for copy that needs markup. */
const hasLede = Boolean(lede) || Astro.slots.has('lede');
const hasAction = Astro.slots.has('default');

/* SELF-SKIP (§4.2). With no heading and nothing else to show, this renders
   nothing at all — not an empty wrapper. See the rule in ARCHITECTURE §4.2. */
const hasContent = Boolean(heading) || Boolean(eyebrow) || hasLede || hasAction;
---

{hasContent && (
<div
  id={id}
  class:list={[
    'flex flex-col gap-md',
    /* TOP-ALIGNED, not bottom. Both columns start at y=0 in the design
       (Figma 788:8574 and 788:8576 are both at the frame's top edge), and
       bottom-aligning them made a two-line heading and a four-line lede hang
       off a shared baseline that the design never draws. */
    split && hasLede && 'md:grid md:grid-cols-12 md:items-start md:gap-lg',
    className,
  ]}
>
  <div class:list={['flex flex-col gap-xs', split && hasLede && 'md:col-span-7', measure && 'measure']}>
    {eyebrow && <p class="text-eyebrow">{eyebrow}</p>}
    {headingLevel === 'h1' && <h1 class={headingClass}>{heading}</h1>}
    {headingLevel === 'h2' && <h2 class={headingClass}>{heading}</h2>}
    {headingLevel === 'h3' && <h3 class={headingClass}>{heading}</h3>}
    {headingLevel === 'h4' && <h4 class={headingClass}>{heading}</h4>}
  </div>

  {
    (hasLede || hasAction) && (
      /* TWO NESTED DIVS, AND BOTH EARN THEIR KEEP. The outer one places the
         column and pushes its contents to the RIGHT edge; the inner one is the
         content block, and its text and action stay LEFT-aligned inside it.

         The split is what makes "right-aligned" mean the right thing. Setting
         `text-align: right` would rag the lede down its left edge and push the
         action away from the copy it belongs to. What the design aligns is the
         BLOCK: its right edge meets the container's, and everything inside it
         reads from a single left margin.

         `md:col-span-4 md:col-start-9` is the design's own column — 432px at
         1440 (Figma 1336:25792), the same one the category and product heroes
         already use. It replaces `md:col-span-5`, which flowed from column 8
         and came out 546 wide. While the lede fills its column the two read
         alike; `justify-end` is what holds the edge when it does not. */
      <div class:list={['flex', split && 'md:col-span-4 md:col-start-9 md:justify-end']}>
        <div class="gap-md flex flex-col items-start">
          {hasLede && (
            <p class="text-body text-secondary measure">
              <slot name="lede">{lede}</slot>
            </p>
          )}
          <slot />
        </div>
      </div>
    )
  }
</div>
)}
