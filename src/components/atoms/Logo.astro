---
/**
 * The CentiPack wordmark (§4.1).
 *
 * The v1 Figma lockup, 228 × 48: the badge, the wordmark and the "SPECIALTY
 * COLD CHAIN PACKAGING" line, exported as outlines and merged by SVGO into a
 * single path at two-decimal precision — 8,540 B of path data, down from 26,229
 * B as Figma exported it across 29 paths.
 *
 * REPLACED 2026-10-16 for the v1 design round. The strapline changed — it read
 * "SPECIALTY PACKAGING & COLD CHAIN" — and the new export had to be put through
 * the same three steps as the old one before it could ship, because Figma's raw
 * output breaks every property this file depends on:
 *
 *   29 paths           -> one, merged (nothing overlaps the badge, so the
 *                         knockout survives a merge; checked before merging)
 *   fill="#1F1F1F"     -> currentColor, or the mark is invisible on the dark
 *                         footer, which is most of where it appears
 *   a clip-path + id   -> dropped; the rect is the viewBox, so it clipped
 *                         nothing and only contributed an id that duplicates
 *                         when the mark is on a page twice
 *
 * The badge still carries the arrow as a HOLE rather than a second shape — it
 * arrives from Figma as a boolean subtract, which is the one thing the export
 * got right and the thing that makes the mark theme-proof.
 *
 * ONE `currentColor` FILL, AND THE BADGE IS A KNOCKOUT. The arrow inside the
 * black square is a hole in the path rather than a second, lighter shape, so
 * the whole mark is exactly one colour and the page ground shows through the
 * arrow. That is what makes it theme-proof without a second asset: on light it
 * is a dark badge with a light arrow, on dark a light badge with a dark one,
 * which is precisely how the nav and the footer draw it in Figma. It is inlined
 * rather than referenced as `<img src="…svg">` because an <img> is a separate
 * document, so `currentColor` inside it would resolve against its own root.
 *
 * No `<defs>`, no ids: Figma's export wrapped the mark in a clip path whose
 * rect is the viewBox — a no-op that would have put a duplicate id on every
 * page the moment the mark appears in both the nav and the footer.
 *
 * No `width` attribute and no fixed height: the caller sizes it, normally with
 * `w-nav-logo`. A wordmark pinned to a height is a wordmark that breaks the nav
 * rhythm the moment someone swaps in a mark with a different aspect ratio.
 *
 * `title` gives the mark an accessible name. Omit it inside a link that already
 * names itself, or the link gets announced twice.
 */
interface Props {
  class?: string;
  title?: string;
}

const { class: className, title } = Astro.props as Props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 228 48"
  fill="none"
  class:list={['h-auto w-full', className]}
  role={title ? 'img' : 'presentation'}
  aria-label={title}
  aria-hidden={title ? undefined : 'true'}
>
