---
import Media from './Media.astro';
import Button from '../atoms/Button.astro';
import type { CategoryView } from '../../lib/catalogue';

/**
 * "The rest of the build" (§4.2) — the pair of cross-links at the foot of every
 * category page.
 *
 * REDESIGNED 2026-10-18 (Figma 1005:14054). It was a 432px heading column with
 * two compact rows beside it; it is now a heading block ACROSS the top with two
 * half-width cards under it. Each card is a 240px picture flush to its own left
 * edge, a title and a line of copy beside it, and a text link pinned to the
 * bottom of that column.
 *
 * THE CARD IS A LIGHT PLATE ON A DARKER BAND — `bg/primary` on `bg/secondary`,
 * which is the inverse of the usual arrangement and the reason the card needs
 * no border: the ground change is the edge.
 *
 * ONE TARGET, ONE ACCESSIBLE NAME. The link at the bottom is the only anchor
 * and `.cross-link-target` stretches its ::after over the whole card, so a
 * press anywhere follows it. The card is NOT wrapped in an <a>, which would
 * fold the heading, the copy and the link label into a single announced name.
 * `scripts/verify/pointer.mjs` asserts that hit area still works.
 */
interface Props {
  /** The eyebrow over the section's standfirst. */
  eyebrow: string;
  /** The standfirst. Drawn at h4 in a 600px measure, not as a heading. */
  body: string;
  /** The other categories — two of them, on every page that renders this. */
  categories: readonly CategoryView[];
  id?: string;
}

const { eyebrow, body, categories, id } = Astro.props as Props;

/* SELF-SKIP (§4.2): nothing to cross-link to, nothing to render. */
const hasContent = categories.length > 0;

/**
 * "Explore custom boxes →", derived rather than stored.
 *
 * The design writes it out for two of the three categories and both follow the
 * same rule exactly — "Explore" plus the display name, lower-cased. A fourth
 * label field on the collection would be three strings nobody can get wrong
 * stored so they can be, and the third ("Explore cold chain packaging") falls
 * out of the same rule. If a category ever needs to break it, that is the
 * moment it becomes a field.
 */
const exploreLabel = (category: CategoryView): string =>
  `Explore ${category.pageTitle.toLowerCase()}`;
---

{hasContent && (
<div id={id} class="gap-lg flex flex-col">
  <div class="gap-md flex flex-col">
    <p class="text-eyebrow">{eyebrow}</p>
    {/* `text-h4` and a <p>, not a heading: the design sets this at 24px but it
        is a sentence about the two cards under it, not a title over them. The
        cards carry the headings. 600px is the measure it is drawn in. */}
    <p class="text-h4 text-primary max-w-[37.5rem]">{body}</p>
  </div>

  <ul class="list-bare gap-lg grid md:grid-cols-2">
    {
      categories.map((category) => (
        <li class="cross-link bg-base rounded-card relative flex flex-col overflow-hidden md:min-h-[8rem] md:flex-row md:gap-lg md:pr-lg">
          {/* `gap-lg`/`pr-lg` ARE 24px AND THE DESIGN DRAWS 20 (Figma 1275:3342).
              Snapped to the scale rather than written as an arbitrary 1.25rem:
              there is no 20px step, rhythm on this site comes off the token scale,
              and a one-off 20 here would be the first off-scale gap in the repo.
              The same ruling the section's 80 → 96 padding got, for the same
              reason. Everything else on this card is the drawn number — 128px
              floor, 6px radius, 240px square, 20/16/15px type, 8px title gap. */}
          {/* STACKED ON A PHONE, BESIDE THE COPY FROM md UP. A 240px square
              next to three lines of text is a row at 768 and a sliver at 390,
              so the card turns into a picture over its copy — the usual mobile
              card, and the only shape that gives the photograph room.

              THE CORNERS COME FREE, which is the point of clipping on the card
              rather than rounding the picture. `overflow-hidden` on a
              `rounded-card` parent clips whichever corners the child actually
              touches: left-top and left-bottom when the picture is beside the
              copy, top-left and top-right when it is above it, square on the
              edge that runs into the card. Rounding the image itself would
              have needed a different rule per breakpoint and would have been
              wrong at one of them.

              240px wide and the card's full height from md — `md:h-full` on
              the Media rather than a ratio: the height comes from the text
              column beside it, and on a phone the 1:1 governs instead.

              `cardThumb` FIRST, `cardImage` ONLY AS A FALLBACK. The square is a
              separate photograph for this box; the card shot is a 5:6 portrait
              whose middle band is what a 1:1 crop of it would show. The fallback
              is here so a category that has not been given a square still draws
              a real picture rather than a hole. */}
          <div class="w-full flex-none md:w-[15rem] md:self-stretch">
            <Media
              image={category.cardThumb ?? category.cardImage}
              label={`${category.pageTitle} — thumbnail`}
              ratio="1 / 1"
              sizes="(min-width: 48rem) 240px, 100vw"
              class="md:h-full"
            />
          </div>

          <div class="p-lg gap-md flex min-w-[0px] flex-1 flex-col justify-between md:px-0">
            <div class="gap-xs flex flex-col">
              <h3 class="text-h5 text-primary">{category.pageTitle}</h3>
              <p class="text-body text-secondary">{category.crossBody}</p>
            </div>
            {/* `self-start` SHRINK-WRAPS THE LINK. As a stretched flex item it
                was the full width of the text column with `justify-center`
                inside it, so the box was flush left and the LABEL sat in the
                middle of the card — out of line with the title and copy above
                it. Sizing the box to its content puts the label on the same
                left edge as everything else. It does not shrink the hit area:
                that is the `::after`, which is measured against the card. */}
            <Button
              href={category.href}
              variant="ghost"
              size="link"
              icon="arrow"
              class="cross-link-target self-start"
            >
              {exploreLabel(category)}
            </Button>
          </div>
        </li>
      ))
    }
  </ul>
</div>
)}
