---
import BaseLayout from '../components/shells/BaseLayout.astro';
import Section from '../components/Section.astro';
import Button from '../components/atoms/Button.astro';
import SectionHeader from '../components/blocks/SectionHeader.astro';
import CategoryCard from '../components/blocks/CategoryCard.astro';
import Media from '../components/blocks/Media.astro';
import { getCategories, toPageImage } from '../lib/catalogue';
import { SITE } from '../consts';
import heroImage from '../assets/home/centipack-home-hero.avif';
/* TEMPORARY, ON INSTRUCTION. The collage's own five shots are owed; until they
   arrive it borrows the product catalogue's, which are the same objects on the
   same ground. They are imported from `assets/products` rather than copied into
   `assets/home`, so there is one file per product and swapping back is five
   lines. */
import volumeCooler from '../assets/products/eps-foam-coolers.avif';
import volumeGelPack from '../assets/products/gel-packs.avif';
import volumeMailer from '../assets/products/insulated-metallic-mailers.avif';
import volumeVialKit from '../assets/products/vial-kits.avif';
import volumeBox from '../assets/products/vial-presentation-boxes.avif';
import { Image } from 'astro:assets';

/**
 * Home (§4.4).
 *
 * A stack of Sections, and nothing else. No spacing decision is made on this
 * page: `space` is the only rhythm control and there is no such thing as a
 * spacer div. Nothing below a Section sets a gutter, a max-width or a page
 * centering — most of which do not compile, deliberately.
 *
 * The three cards in section 3 are the CATEGORIES COLLECTION, through its
 * adapter, from the first commit — not a hardcoded trio that would have to be
 * migrated later (§5).
 *
 * Copy is verbatim from Figma 788:8519. One deliberate departure, recorded as
 * open question 16: the design drops the hero lede at 1440 and keeps it at 402.
 * It ships at both widths here, because hiding content at one breakpoint is a
 * content-loss pattern rather than a layout, and because that sentence is also
 * the site's meta description.
 */
const categories = await getCategories();

/**
 * The hero picture. Normalized here the way the adapter normalizes a
 * collection's — same `{ src, width, height, alt }` shape — because Media takes
 * one thing and should not care that this one is a page asset rather than a
 * content field.
 */
/* PROJECT: drop the portrait-framed hero in beside the wide one and pass it as
   `mobile` below. Media renders <picture> the moment it is there; until then the
   wide file is cropped to 1:1.25 on mobile by `.hero-media`. */
// import heroImageMobile from '../assets/home/centipack-home-hero-mobile.avif';
const heroPicture = await toPageImage({
  src: heroImage,
  // mobile: heroImageMobile,
  alt:
    'The CentiPack range in one line-up: two insulated mailers, blue mailer and drawer boxes, an EPS foam cooler in its corrugated outer, jars, a pump bottle, and a white mailer box.',
});

/**
 * The closing collage. Five product shots placed AT THE FIGMA OFFSETS rather
 * than in a grid: the arrangement is the point — two of them bleed past the
 * container into the gutters — and it is what the motion pass will animate.
 *
 * The numbers are percentages of the 1344 × 967 container the design draws them
 * in, which is why they are data here rather than utility classes: they are
 * measurements, and a measurement in a class name is a measurement nobody can
 * check against the source.
 */
/* `ratio` IS THE DRAWN BOX, not the file's own proportion — and it exists
   because the borrowed shots are all one portrait 1037 x 1284 while the design's
   five boxes run from 288:540 to 618:593. Without it the tall crop at the top of
   the collage grew down over "Thermal integrity." Each number below is the pixel
   size of the shot this slot used to hold, which is the design's box; the
   photograph is cropped INTO it rather than the composition bending around a
   photograph. Measured on the built page, not guessed: the five files are
   identical in size, so every slot needed this. */
const collage = [
  { image: volumeCooler, alt: 'An EPS foam cooler inside its open corrugated outer, printed rush, perishable, insulated.', left: 39.79, top: -0.05, width: 22.99, ratio: '618 / 593', mobile: { left: 38, top: 1, width: 24 } },
  { image: volumeGelPack, alt: 'Five gel packs in printed pillow pouches, stacked together.', left: -3.57, top: 24.6, width: 13.39, ratio: '360 / 628' },
  { image: volumeMailer, alt: 'A sealed blue insulated mailer printed "Refrigerate upon opening".', left: 92.86, top: 22.68, width: 10.71, ratio: '288 / 540' },
  { image: volumeVialKit, alt: 'A branded jar opened to show vials inside.', left: 69.07, top: 65.51, width: 19.42, ratio: '522 / 628', mobile: { left: 60, top: 76, width: 22 } },
  { image: volumeBox, alt: 'A blue drawer box slid open to show two vials in a fitted insert.', left: 21.5, top: 73.73, width: 19.12, ratio: '514 / 504', mobile: { left: 14, top: 83, width: 21 } },
];

/**
 * The hero's three claims. Page-local because they are three sentences about
 * this page, not a repeating content type — a collection for three numbers that
 * appear once is the abstraction §4.5 says to wait for.
 */
/**
 * THE LABELS ARE FIGMA'S AGAIN. Two of the three were not: "point of contact"
 * and "years in cold chain industry" appear NOWHERE in the design file —
 * searched, zero nodes — and the brief says copy is lifted verbatim. The
 * design's own strings are below, and they are also what the client's reference
 * image shows.
 *
 * Worth knowing before trusting this: both Figma frames carrying these labels
 * (788:8317 and 788:8559) are marked `hidden="true"`, i.e. the band is switched
 * off in the design file. The band exists on this page because it was asked for
 * in review, not because the design draws it — so "which of these is canonical"
 * is a question for the human, recorded as open question 32.
 */
/**
 * NO PAYOFF LINES. The v7 redline gave each number a label AND a payoff
 * sentence; the reference screens show the label alone, which is also what the
 * band can carry — the payoffs ran to ninety characters and took the band from
 * 120px to 327px on a phone (open question 39, now moot).
 */
const stats = [
  { value: '1', label: 'dedicated contact' },
  { value: '0', label: 'distributors in between' },
  { value: '20+', label: 'years of combined cold-chain expertise' },
  { value: '3', label: 'integrated layers' },
];
---

<BaseLayout
  title={`${SITE.name} — cold chain packaging for compounding pharmacies`}
  description={SITE.description}
>
  {/*
    1 — Text hero.

    `main`, NOT `narrow`, AND THE HEADLINE CARRIES ITS OWN MEASURE. The design
    sets this h1 in TWO lines inside a 912px text box, and `narrow` is exactly
    that box — 63rem less two gutters is 912px at 1440, which is the design's own
    number. It still came out in three lines, and the reason is not the layout:

      natural width of the line, measured at 64px   1876px
      two lines therefore need at least             938px each
      the narrow column gives                       912px

    Two lines are arithmetically impossible at 912px; the browser sets this
    string about 3.5% wider than Figma does at the same size and tracking.
    Measured by sweeping the cap: 980px → three lines, 1000px → two, at [888,
    988]. So the Section widens and the HEADLINE takes the measure instead —
    which is what `.measure` already does for body copy, one step up. The flex
    column centres it, so nothing here needs `mx-auto` (§3.1).
  */}
  <Section width="main" spaceTop="nav" spaceBottom="lg" class="text-center">
    <div class="gap-xl flex flex-col items-center">
      <h1 class="hero-headline text-h1 text-primary">
        Cold chain packaging for high-volume compounding pharmacies
      </h1>
      {/* v8 DRAWS A HERO BODY, reversing the "hero: no subtext" call from the
          2026-09-12 review. The design's own mobile frame carries this line, so
          the later instruction wins — flagged in the WORKLOG rather than
          silently overriding an earlier one. */}
      <p class="text-body text-secondary measure">
        Insulated shippers, refrigerants, custom boxes, and pharmacy formats — one supplier, built
        for pharmacies producing at scale.
      </p>
      {/* No lede here. The design does not draw one at either width; the
          sentence lives on as the page's meta description, which is where it
          was doing its real work. Closes open question 16. */}
      <div class="gap-sm flex flex-wrap justify-center">
        <Button href={SITE.contactHref} variant="primary" icon="square" iconPosition="start">
          Contact us
        </Button>
        <Button href="/products" variant="secondary">Explore products</Button>
      </div>
    </div>
  </Section>

  {/*
    2 — The hero picture, and the three claims that sit on it.

    `width="full"` keeps the Section wrapper — theme and rhythm behave identically
    — and drops only the max-width and the gutter, which is what full-bleed means
    here. The stat cards are REAL CARDS over the photograph: `bg-overlay` and
    `border-overlay` are named translucent tokens (§2.3), not ad-hoc alpha, and
    `data-theme="dark"` is what makes them resolve white over the scrim.

    A <dl> rather than three divs: each card is a term and its value, and that is
    what a description list is for.
  */}
  <Section width="full" space="none">
    <div
      data-theme={heroPicture ? 'dark' : undefined}
      class:list={['relative isolate', heroPicture && 'media-scrim']}
    >
      <Media
        image={heroPicture}
        label="Home hero — the CentiPack range in one line-up"
        ratio="5 / 3"
        loading="eager"
        fetchpriority="high"
        class="hero-media"
      />

      {/*
        Three across at EVERY width, which is what the design draws and what the
        band has room for — stacking them overflowed the 4:5 crop and landed on
        the hero above it.

        ONE TYPE STEP AT BOTH WIDTHS, and that is the system refusing something
        rather than a compromise: `md:text-h5` is not a utility, because the type
        scale is not in @theme (§2.1) and the named styles are the only way to
        apply type. Type never jumps at a breakpoint here. The tokens are already
        fluid — the value is 36px at 402 and 64px at 1440, which is exactly what
        the design draws — so the only thing the breakpoint changes is padding.
      */}
      {/* FULL BLEED BELOW md, contained above it. No gutter and no bottom
          padding on mobile — the band runs edge to edge and sits flush on the
          bottom of the picture; the page's gutter comes back as the columns'
          own padding. From md the three cards want the container again. */}
      <div class="md:container-main md:pb-2xl absolute inset-x-0 bottom-0 z-10">
        {/*
          ONE PLATE ON MOBILE, THREE CARDS FROM md. Below the breakpoint the
          three claims share a single glass panel divided by hairlines; from md
          they separate into the three cards the desktop design draws. That is
          two different objects, not one object with a gap that changes, so the
          whole treatment lives in `.hero-stats` / `.hero-stat` rather than in
          utilities here — a utility cannot be removed at a breakpoint, and
          utilities outrank the component layer, so leaving the card classes in
          the markup would have made the mobile plate impossible to express.
        */}
        <dl class="hero-stats grid grid-cols-2 md:grid-cols-4">
          {
            stats.map((stat) => (
              <div class="hero-stat flex flex-col">
                <dt class="text-h1 text-primary">{stat.value}</dt>
                {/* HYPHENATED, because three cards across 320px leaves 67px of
                    text and "distributors" is 97px of it. Measured: the label
                    spilled 30px past its own card and over the one beside it at
                    320, 16px at 360, 6px at 390 — invisible to the page-level
                    overflow sweep, because the document never scrolled.
                    The alternatives were worse. Stacking overflowed the 4:5 crop
                    (recorded above); a smaller type step at a breakpoint is the
                    one thing this type scale refuses (§2.1). Hyphenation is what
                    the browser has for exactly this, it needs the <html lang>
                    that is already there, and it does nothing at all at any width
                    where the word fits. */}
                <dd class="text-h5 text-primary hyphens-auto">{stat.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  {/* 3 — Three layers. The band the design sets on the cream ground. */}
  <Section space="lg" class="bg-subtle">
    <div class="gap-2xl flex flex-col">
      <SectionHeader heading="Three integrated layers. Available individually or as a complete solution. Built to perform." headingLevel="h2" size="h2" split>
        <Fragment slot="lede">
          A cold-chain system, not just packaging: shippers and refrigerants validated for 2–8°C
          from 24 to 72 hours, with formats and custom boxes built to the same standard. Behind it,
          20+ years of combined cold-chain expertise and supply built for the largest compounding
          programs.
        </Fragment>
        <Button href="/products" variant="ghost" size="link" icon="arrow">Browse all formats</Button>
      </SectionHeader>

      {/*
        NESTED ORDER, NOT CATALOGUE ORDER. The lede above names them inward-out —
        "the format it is dispensed in, the custom box, and the shipper" — and
        the heading calls them three layers, so the cards read in that same
        order. The nav and the footer keep the catalogue's own order, which is
        the order someone browsing a menu expects. Same three records, ordered
        for the sentence they sit under.
      */}
      <ul class="list-bare gap-sm grid md:grid-cols-3">
        {
          [...categories].reverse().map((category) => (
            <li class="flex">
              <CategoryCard category={category} headingLevel={3} class="w-full" />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/*
    4 — Testimonial. One instance on one page, so page markup, not a block.

    TWO RULES, AND THEY ARE DIFFERENT RULES. The section carries a bottom border
    across the full width; the card inside it carries left and right borders,
    inset by one step from the page edge. That pair is what makes the quote read
    as a plate set into the page rather than as another band — it is drawn that
    way in Figma (788:8623) and it is the one place on this page where `--line`
    does structural work.
  */}
  {/* `bg-base`, not `bg-surface`: neither this band nor the one after it
      declares a fill in Figma, so both inherit the page ground. The rules are
      what separate this section, not a change of ground — which is the whole
      reason it is drawn with borders. */}
  <Section space="none" class="border-line border-b">
    {/* 64px of air on mobile rather than 192. `py-5xl` is the desktop
        measure and on a phone it pushed the quote most of a screen away from
        anything either side of it. */}
    <figure class="border-line py-3xl md:py-5xl px-lg gap-xl md:gap-3xl flex flex-col items-center border-x text-center">
      <svg class="text-primary w-icon" viewBox="0 0 44 28.66" fill="currentColor" aria-hidden="true">
        <path d="M22.17 28.66 33.8 0H44l-6.05 28.66zM0 28.66 11.53 0h10.3L15.8 28.66z"></path>
      </svg>
      {/* 794px is the measure the design sets for this one quote, and no token
          lands on it: `measure` is 66ch of the CURRENT size, which at 32px is
          over a thousand pixels. An arbitrary value with its reason stated, per
          §4.2 — the second display quote that wants this width makes it a
          token. */}
      <blockquote class="text-h3 text-primary max-w-[49.625rem]">
        <p>
          CentiPack has been great to work with. As our pharmacy has grown, they’ve been able to
          scale right along with us. They’re reliable, easy to work with, and their pricing has been
          some of the best we’ve seen.
        </p>
      </blockquote>
      <figcaption class="text-body text-secondary">Director of Operations, high-volume compounding pharmacy</figcaption>
    </figure>
  </Section>

  {/* 5 — Volume. This page's closing CTA; there is no CtaBanner on Home. */}
  <Section space="lg" width="main">
    <div class="volume relative isolate flex flex-col items-center text-center">
      {/* 620px is the column the design centres this block in, and the collage
          is placed around it — so the width is load-bearing rather than
          cosmetic: at the container's full 1344 the heading runs under the two
          side shots. An arbitrary value with its reason stated (§4.2); this is
          the second editorial width on the page, and a third makes it a token. */}
      <div class="gap-lg relative z-10 flex max-w-[38.75rem] flex-col items-center">
        <h2 class="text-h2 text-primary">Thermal integrity. Validated performance. Manufacturing scale.</h2>
        <p class="text-body text-secondary measure">
          Mass volume through our own manufacturing partners — no distributors, no markup in
          between. Quoted to your volumes and lanes.
        </p>
        <Button href={SITE.contactHref} variant="primary" icon="square" iconPosition="start">
          Contact us
        </Button>
      </div>

      {/*
        The collage, placed. Absolute from `md` up at the design's own offsets —
        two of them deliberately bleed past the container into the gutters, which
        is the whole character of the arrangement and the reason a grid could not
        stand in for it. Below `md` there is no room to scatter anything, so they
        fall back to a two-up flow that reads as a strip.

        `aria-hidden`: these five are decoration around a heading that already
        says what they are. Five alt texts describing product photographs here
        would be five interruptions on the way to the button.
      */}
      <!-- `data-bleed`: two of the five hang into the gutter on purpose (see
           above), which is content outside its own box — declared here so the
           sweep's spill assertion reads it as art direction rather than a
           defect. -->
      <ul
        class="volume-collage list-bare"
        aria-hidden="true"
        data-bleed
      >
        {
          collage.map((shot) => (
            <li
              class="volume-collage-item"
              data-on-mobile={shot.mobile ? '' : undefined}
              style={[
                `--at-left:${shot.left}%;--at-top:${shot.top}%;--at-width:${shot.width}%;--at-ratio:${shot.ratio}`,
                shot.mobile &&
                  `--at-left-m:${shot.mobile.left}%;--at-top-m:${shot.mobile.top}%;--at-width-m:${shot.mobile.width}%`,
              ]
                .filter(Boolean)
                .join(';')}
            >
              <Image src={shot.image} alt="" widths={[240, 480, 720]} class="rounded-md w-full" />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>
</BaseLayout>
