---
import Logo from '../atoms/Logo.astro';
import Section from '../Section.astro';
import { getFooterColumns, legalLinks } from '../../data/navigation';
import { SITE } from '../../consts';

/**
 * Site footer (§4.3).
 *
 * A Section with `as="footer"` and `theme="dark"` — so it gets the same
 * container, the same theme mechanism and the same vertical rhythm as every
 * other band on the page, and its links align to `--site-margin` exactly like
 * the nav logo above them. Nothing here sets its own gutter, and nothing here
 * names a colour: the dark theme does that, which is why the wordmark comes out
 * as a light badge with a dark arrow without a second asset.
 *
 * The three product columns are the CATALOGUE, not a list — same traversal the
 * nav panel uses, so a product added to `src/content/products` appears in both
 * or in neither.
 */
const year = new Date().getFullYear();
const columns = await getFooterColumns();
const contact = [
  { href: 'mailto:info@centipack.com', label: 'info@centipack.com' },
  { href: 'tel:+18773502799', label: '(877) 350-2799' },
];

/* Same rule as the nav: the underline is the hover, not a colour. See
   `.link-underline` in global.css. */
const linkClass = 'link-underline text-body text-primary';
---

<Section as="footer" theme="dark" space="lg" spaceBottom="sm">
  <div class="gap-xl grid lg:grid-cols-5">
    <div class="gap-lg lg:col-span-2 flex flex-col items-start">
      <Logo class="w-nav-logo" title={SITE.name} />
      <ul class="fade-group list-bare gap-sm flex flex-col">
        {contact.map(({ href, label }) => (
          <li><a href={href} class={linkClass}>{label}</a></li>
        ))}
      </ul>
    </div>

    <nav aria-label="Footer" class="gap-xl lg:col-span-3 grid sm:grid-cols-2 lg:grid-cols-4">
      {
        columns.map((column) => (
          <div class="gap-sm flex flex-col">
            <p class="text-eyebrow">{column.title}</p>
            {/* One fade group per column: hovering a link drops its siblings
                back, and the group is the column because that is the set the
                reader is scanning. */}
            <ul class="fade-group list-bare gap-sm flex flex-col">
              {column.links.map(({ href, label }) => (
                <li><a href={href} class={linkClass}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="border-line mt-5xl pt-md gap-md flex flex-col border-t sm:flex-row sm:items-center sm:justify-between">
    <p class="text-caption text-tertiary">&copy; {year} {SITE.name}. All rights reserved.</p>
    {/* The social marks were here and are gone at the client's request. The
        wrapper that held them beside the legal row went with them — a flex row
        around a single child is a div doing nothing. `socialLinks` and
        `.social-link` are deleted rather than left commented out; git has them
        if the accounts ever arrive. */}
    <ul class="fade-group list-bare gap-lg flex flex-wrap">
      {
        legalLinks.map(({ href, label }) => (
          <li>
            <a href={href} class="link-underline text-caption text-tertiary">
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Section>
