---
import Logo from '../atoms/Logo.astro';
import Button from '../atoms/Button.astro';
import Media from '../blocks/Media.astro';
import { getNavigation, isGroup } from '../../data/navigation';
import { SITE } from '../../consts';
import { canonicalPath } from '../../lib/urls';

/**
 * Site navigation (§4.3).
 *
 * ONE NAV TREE means one source of truth for the links — and here that source is
 * the CATALOGUE itself, through `src/data/navigation.ts`. The desktop bar and
 * the mobile panel are structurally different on purpose, because the
 * interaction is: a mega menu is a button-and-panel disclosure on desktop, and
 * on mobile the same columns FOLD INTO the menu as labelled sub-lists with no
 * extra JavaScript at all. What is forbidden is two hand-maintained link lists,
 * which is how one of them goes stale.
 *
 * The mobile menu is a native <details>/<summary>: keyboard-operable, announced
 * correctly, and zero JS. The burger morph is CSS.
 *
 * THE MEGA PANEL IS FULL-BLEED, WITH THE CONTAINER INSIDE IT (§3.1). It is
 * positioned against the <header> rather than against its own <li>, so the panel
 * spans the viewport while its COLUMNS land on the same gutter line as the logo
 * above them and every section heading below.
 *
 * The dropdown is a disclosure, NEVER hover-only — `<button aria-expanded>`
 * toggling a panel, Escape closing and returning focus, outside press closing.
 * src/scripts/disclosure.ts is the single delegated module that owns all of them.
 */
const here = canonicalPath(Astro.url.pathname);
const navigation = await getNavigation();

/**
 * `aria-current="page"` is the accessible half; the styling hangs off it too.
 *
 * Takes `undefined` because a nav entry may be a name with no destination (see
 * `NavLink.href`). Nothing is the current page when there is no page: returning
 * false here is what keeps the accent off an inert product name.
 */
const isCurrent = (href: string | undefined): boolean => {
  if (!href || href.includes('#')) return false;
  return here === canonicalPath(href);
};

const groupIsCurrent = (group: {
  columns: readonly { links: readonly { href?: string }[] }[];
}): boolean => group.columns.some((column) => column.links.some((link) => isCurrent(link.href)));

/* NO HOVER COLOUR. The hover state is `.link-underline` — a hairline drawn in
   from the left — and the fade group already dims the siblings, so a colour
   change on top was a third answer to a question two things had answered.
   `aria-current` keeps the accent: that is the page you are on, not a hover. */
const linkClass = 'link-underline text-body text-primary aria-[current=page]:text-accent';
---

<a href="#main" class="skip-link text-sm">Skip to main content</a>

{/* The rule under the nav spans the full viewport; the container starts inside
     it, so the hairline is not interrupted by the gutter. `sticky` also makes
     this the containing block the mega panel positions against. */}
{/* The navbar sits on the ground the page starts on, and that is `bg/primary`
     (#f9f7f5) again — it was `bg/secondary` for one round while the whole home
     page was on #f2eee8. Re-sampled off the frame with Figma's canvas
     excluded, which is the only reliable way to read these (entry 69).

     A STICKY BAR HAS TO BE OPAQUE, so it cannot simply inherit: scrolling a
     white product-page section under a transparent nav would put body copy
     behind the logo. It picks one ground, and this is it. */}
<header class="border-line bg-base sticky top-0 z-40 border-b">
  <div class="container-main">
    <nav aria-label="Main" class="h-nav gap-md flex items-center justify-between">
      {/* `.nav-logo` owns the width, the no-shrink and the badge crop; see
           global.css. The class is on the LINK because the link is the flex item
           that was being squeezed. */}
      <a
        href="/"
        class="nav-logo rounded-sm"
        aria-label={`${SITE.name} — home`}
        aria-current={here === '/' ? 'page' : undefined}
      >
        <Logo />
      </a>

      {/* THE BAR IS ONE RIGHT-HAND GROUP: links, then the call to action.
           The logo holds the left edge alone, which is what the design draws and
           what keeps the whole of the nav's interactive surface in one place. */}
      <div class="gap-xl flex items-center">
      <ul class="list-bare gap-xl hidden items-center lg:flex">
        {
          navigation.map((item) =>
            isGroup(item) ? (
              <li data-disclosure-group>
                <button
                  type="button"
                  id={item.id}
                  data-disclosure
                  aria-expanded="false"
                  aria-controls={`${item.id}-panel`}
                  class:list={[
                    linkClass,
                    'gap-sm flex cursor-pointer items-center rounded-sm',
                    // A group whose panel contains the current page reads as
                    // active, but the TRIGGER never takes aria-current: it is a
                    // button, not a link, and aria-current on it would announce
                    // a page that is not there. The link inside carries it.
                    groupIsCurrent(item) && 'text-accent',
                  ]}
                >
                  {item.label}
                  <span class="nav-caret" aria-hidden="true" />
                </button>

                <div id={`${item.id}-panel`} class="nav-panel" aria-labelledby={item.id}>
                  {/* THREE CARDS, NOT FOUR COLUMNS (Figma 1464:10244). The
                      panel used to be four link columns and a help card; it is
                      now one card per category, each a title, a standfirst,
                      then either the category's products or its photograph,
                      with its own route out at the foot. See `getNavigation`
                      for why the list-or-picture choice is derived. */}
                  <div class="container-main py-xl gap-lg grid lg:grid-cols-3">
                    {item.columns.map((column) => {
                      /* A CARD WITH NO LINKS OF ITS OWN BECOMES ONE TARGET.
                         The rule is about NESTING, not about pictures: cold
                         chain lists five product links, and a hit area over
                         the whole of that card would sit on top of all five.
                         The other two hold a heading, a sentence, a photograph
                         and a single route out — nothing to swallow — so the
                         card is the press. Same derivation as the picture
                         itself (`getNavigation`), read the same way. */
                      const wholeCard = column.links.length === 0;
                      return (
                      <div
                        class:list={[
                          'bg-subtle rounded-card p-lg gap-md flex flex-col',
                          wholeCard && 'nav-card relative',
                        ]}
                      >
                        <div class="gap-xs flex flex-col">
                          {/* A REAL HEADING, not a styled label: a panel of
                              links with no headings is a list a screen-reader
                              user has to read end to end to navigate. */}
                          <h2 class="text-h5 text-primary">{column.title}</h2>
                          {column.description && (
                            <p class="text-body text-secondary">{column.description}</p>
                          )}
                        </div>

                        {/* `mt-auto` on the foot rather than `justify-between`
                            on the card: the cards are grid siblings and share
                            a row height, so the route out sits on one line
                            across all three however long the standfirst runs. */}
                        {column.links.length > 0 && (
                          <ul class="fade-group list-bare gap-sm flex flex-col">
                            {column.links.map((link) => (
                              <li>
                                {/* A NAME WITH NO PAGE IS A <span>, NOT A DEAD
                                    <a> — still true, and now mostly moot: a
                                    column of nameless products shows its
                                    picture instead and never reaches here. */}
                                {link.href ? (
                                  <a
                                    href={link.href}
                                    class="link-underline text-body text-primary rounded-sm"
                                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                                  >
                                    {link.label}
                                  </a>
                                ) : (
                                  <span class="text-body text-secondary">{link.label}</span>
                                )}
                              </li>
                            ))}
                          </ul>
                        )}

                        {column.links.length === 0 && column.image && (
                          /* THE CLIP IS THE WRAPPER'S JOB, not the image's.
                             `.media-slot` IS the <img> — there is no box
                             around it — so the picture's 2% resting scale has
                             nothing to crop against and would simply render
                             2% larger than its slot. The category and
                             cross-link cards get this free because their
                             photograph is flush to a card that already clips;
                             this one is inset inside the padding with its own
                             radius, so it brings its own. */
                          <div class="rounded-card overflow-hidden">
                            <Media
                              image={column.image}
                              label={`${column.title} — the range`}
                              ratio="384 / 169"
                              sizes="384px"
                            />
                          </div>
                        )}

                        {column.browseLabel && (
                          <div class="mt-auto">
                            {/* STILL ONE LINK WITH ONE NAME. The route out
                                that was already there grows a stretched
                                ::after; a wrapping <a> would fold the
                                heading, the sentence and this label into a
                                single announced name, and would have to
                                swallow this anchor to avoid nesting one.
                                Same ruling as `.category-card-link`. */}
                            <Button
                              href={column.href}
                              variant="ghost"
                              size="link"
                              icon="arrow"
                              class={wholeCard ? 'nav-card-link' : undefined}
                            >
                              {column.browseLabel}
                            </Button>
                          </div>
                        )}
                      </div>
                      );
                    })}
                  </div>
                </div>
              </li>
            ) : (
              <li>
                <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>

      <div class="gap-sm flex items-center">
        {/* `primary` now carries the tan on a light ground and white on a dark
            one, so the `action` variant this used to take is gone — they had
            become two names for one button. See the variant's note in
            Button.astro.

            NO `icon="square"` here: the nav button is label-only in the design.
            The square mark belongs to the closing CTA's button, which keeps it. */}
        <Button href={SITE.contactHref} variant="primary">
          Get a quote
        </Button>

        {/* Mobile disclosure. Same source, folded: a group's columns become
             labelled sub-lists rather than a second disclosure, so the panel
             costs no JavaScript. */}
        <details class="nav-disclosure lg:hidden">
          <summary
            class="h-control-sm w-control-sm flex cursor-pointer list-none items-center justify-center rounded-sm"
          >
            <span class="sr-only">Menu</span>
            <span class="nav-burger" aria-hidden="true"></span>
          </summary>

          {/* FULL-HEIGHT SHEET WITH THE ACTION PINNED (Figma 1464:9785).
               The panel used to be a band that grew to its content and capped
               at 80svh. The v1 menu is the whole screen below the bar, the
               links scroll inside it, and "Get a quote" sits on a solid strip
               at the foot — reachable with the thumb whether the Products fold
               is open or shut, which is the point of pinning it.

               Container inside the full-bleed band, as everywhere: the rows
               land on the same gutter line as the logo above them. */}
          <div
            class="border-line bg-base absolute inset-x-0 top-full flex h-[calc(100svh-var(--nav-height))] flex-col border-t"
          >
            {/* THE DESIGN'S MOBILE MENU IS AN ACCORDION (Figma 1464:10063
                closed, 1464:9785 open). Collapsed is one row — the group's
                label with a plus on the right — and expanding it reveals the
                three category CARDS, the same three the desktop panel draws,
                without their photographs.

                A NESTED <details>, so it still costs zero JavaScript. The
                outer one is the burger; this is the second, and the browser
                owns both. No aria-expanded to keep in sync, and it works
                before any script runs. */}
            <div class="flex-1 overflow-y-auto">
              <div class="container-main py-lg gap-lg flex flex-col">
                {
                  navigation.map((item) =>
                    isGroup(item) ? (
                      <details class="nav-fold">
                        <summary class="nav-fold-summary text-h5 text-primary gap-md flex cursor-pointer list-none items-center justify-between">
                          {item.label}
                          <span class="nav-plus" aria-hidden="true" />
                        </summary>

                        <div class="pt-lg gap-md flex flex-col">
                          {item.columns.map((column) => {
                            /* Same rule as the desktop panel above, and it
                               matters more here: a thumb is a blunter
                               instrument than a pointer. */
                            const wholeCard = column.links.length === 0;
                            return (
                            <div
                              class:list={[
                                'bg-subtle rounded-card p-lg gap-md flex flex-col items-start',
                                wholeCard && 'nav-card relative',
                              ]}
                            >
                              <div class="gap-xs flex flex-col">
                                {/* THE TITLE IS A HEADING AGAIN, not a link.
                                    It was the link because this fold had no
                                    other route to the category page — the
                                    desktop panel carried a "Browse cold chain
                                    →" button per column and the mobile one did
                                    not, so with product pages out of scope the
                                    Products menu on a phone reached zero
                                    destinations.

                                    The v1 card ships that button on both, so
                                    the heading goes back to being a heading
                                    and the route out is the one control that
                                    says where it goes. */}
                                <h2 class="text-h5 text-primary">{column.title}</h2>
                                {column.description && (
                                  <p class="text-body text-secondary">{column.description}</p>
                                )}
                              </div>

                              {/* NO PICTURE HERE, and that is the design's
                                  call rather than a port that ran out of room:
                                  the mobile cards for custom boxes and
                                  pharmacy formats are a heading, a standfirst
                                  and a link, where the desktop ones show the
                                  range. A 330px-wide photograph between a
                                  sentence and its link is a scroll cost on the
                                  one screen that can least afford it. */}
                              {/* THE LINKS AND THE ROUTE OUT ARE ONE GROUP, at
                                  `gap-sm`, where the card's own gap is
                                  `gap-md`. The design spaces every row of this
                                  card 12px apart and the browse link is one of
                                  those rows — it is the sixth item in a list of
                                  places to go, not a footer under a list. A
                                  card with no links gets the card gap instead,
                                  which is the 16px the design draws between a
                                  standfirst and a lone link. */}
                              <div class="gap-sm flex flex-col items-start">
                                {column.links.length > 0 && (
                                  <ul class="list-bare gap-sm flex flex-col">
                                    {column.links.map((link) => (
                                      <li>
                                        {/* Same rule as the desktop panel: a
                                            product name with no page renders as
                                            text, not as a dead <a>. */}
                                        {link.href ? (
                                          <a
                                            href={link.href}
                                            class="link-underline text-body text-primary rounded-sm aria-[current=page]:text-accent"
                                            aria-current={isCurrent(link.href) ? 'page' : undefined}
                                          >
                                            {link.label}
                                          </a>
                                        ) : (
                                          <span class="text-body text-secondary">{link.label}</span>
                                        )}
                                      </li>
                                    ))}
                                  </ul>
                                )}

                                {column.browseLabel && (
                                  <Button
                                    href={column.href}
                                    variant="ghost"
                                    size="link"
                                    icon="arrow"
                                    class={wholeCard ? 'nav-card-link' : undefined}
                                  >
                                    {column.browseLabel}
                                  </Button>
                                )}
                              </div>
                            </div>
                            );
                          })}
                        </div>
                      </details>
                    ) : (
                      <a
                        href={item.href}
                        class="link-underline text-h5 text-primary self-start aria-[current=page]:text-accent"
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                      >
                        {item.label}
                      </a>
                    ),
                  )
                }
              </div>
            </div>

            {/* The solid strip. `shrink-0` because it is the one thing in this
                sheet that must not be scrolled away, and a border above it so
                it reads as a bar rather than as the last row of the list. */}
            <div class="border-line bg-base shrink-0 border-t">
              <div class="container-main py-lg">
                <Button href={SITE.contactHref} variant="primary" class="w-full">
                  Get a quote
                </Button>
              </div>
            </div>
          </div>
        </details>
      </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import '../../scripts/disclosure';
  /* Breakpoint-crossing cleanup: an open panel must not survive the width that
     made it reachable. See the module for why CSS cannot do this. */
  import '../../scripts/viewport';
</script>
